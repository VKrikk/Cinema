&НаСервереБезКонтекста
Функция ПроизвестиЗаменуКонтактныхДанныхНаСервереБезКонтекста(ТаблицаКонтактныхДанных, ИнфоКонтакта)
	
	ЧислоСтрок			= СтрЧислоСтрок(ИнфоКонтакта);
	НовоеИнфоКонтакта	= "";
	ПереводСтроки		= Символы.ПС;
	НомерСтроки			= 1;
	ПризнакОрганизации1	= "ORG:";
	ПризнакОрганизации2	= "ORG;";
	ОргНаименование		= "TITLE;";
	
	Пока ЧислоСтрок >= НомерСтроки Цикл
	
		ПолученнаяСтрока = СтрПолучитьСтроку(ИнфоКонтакта, НомерСтроки);
		
		Для каждого КлючИЗначение Из ТаблицаКонтактныхДанных Цикл
			
			ЗаменяемаяСтрока	= КлючИЗначение.Значение;
			ИскомаяСтрока		= КлючИЗначение.Ключ;
			
			Если СтрНайти(ПолученнаяСтрока, ИскомаяСтрока) = 1 Тогда
				ПолученнаяСтрока = СтрЗаменить(ПолученнаяСтрока, ИскомаяСтрока, ЗаменяемаяСтрока);
			КонецЕсли;
			
		КонецЦикла;
		
		Если СтрНайти(ПолученнаяСтрока, ПризнакОрганизации1) = 1 ИЛИ СтрНайти(ПолученнаяСтрока, ПризнакОрганизации2) = 1 Тогда
			
			НомерСтроки  = НомерСтроки + 1;
			
			Если ЧислоСтрок >= НомерСтроки Тогда
				
				ВтораяСтрока = СтрПолучитьСтроку(ИнфоКонтакта, НомерСтроки);
				
				Если СтрНайти(ВтораяСтрока, ОргНаименование) = 1 Тогда
					ОргЗаголовок = СокрЛП(СтрЗаменить(ПолученнаяСтрока, ПризнакОрганизации1, ""));
					ОргЗаголовок = СокрЛП(СтрЗаменить(ОргЗаголовок, ПризнакОрганизации2, ""));
					ОрганизацИмя = СокрЛП(СтрЗаменить(ВтораяСтрока, ОргНаименование, ""));
					Если ПустаяСтрока(ОрганизацИмя) ИЛИ ПустаяСтрока(ОргЗаголовок) Тогда
						Разделитель = "";
					Иначе
						Разделитель = " ";
					КонецЕсли;
					ПолученнаяСтрока = "Организация: " + ОргЗаголовок + Разделитель + ОрганизацИмя;
				Иначе
					НомерСтроки  = НомерСтроки - 1;
				КонецЕсли;
				
			Иначе
				
				НомерСтроки      = НомерСтроки - 1;
				ПолученнаяСтрока = СокрЛП(СтрЗаменить(ПолученнаяСтрока, ПризнакОрганизации1, "Организация:"));
				ПолученнаяСтрока = СокрЛП(СтрЗаменить(ПолученнаяСтрока, ПризнакОрганизации2, "Организация:"));
				
			КонецЕсли;			
		КонецЕсли;
			
		НовоеИнфоКонтакта = НовоеИнфоКонтакта + ?(ПустаяСтрока(НовоеИнфоКонтакта), "", ПереводСтроки) + ПолученнаяСтрока;
		НомерСтроки = НомерСтроки + 1;
	
	КонецЦикла;
		
	Возврат НовоеИнфоКонтакта;

КонецФункции

&НаСервере
Функция СформироватьТабличныйДокументНаСервере(МассивКонтактов)

	НачалоИмени		= "N;";
	Фотография		= "PHOTO;";
	ТаблицаСимволов	= ПолучитьТаблицуСимволов();
	ПереводСтроки	= Символы.ПС;
	ТочкаСЗапятой	= ";";
	Двоеточие		= ":";
	ПустаяКартинка	= Новый Картинка;
	ТаблицаКонтактныхДанных = ПолучитьТаблицуКонтактныхДанныхНаСервереБезКонтекста();

	ТаблицаКонтактов = Новый ТаблицаЗначений;
	ТаблицаКонтактов.Колонки.Добавить("ИмяКонтакта",  Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(200, ДопустимаяДлина.Переменная)));
	ТаблицаКонтактов.Колонки.Добавить("ИнфоКонтакта", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная)));
	ТаблицаКонтактов.Колонки.Добавить("ФотоКонтакта", Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(0, ДопустимаяДлина.Переменная)));
	ТаблицаКонтактов.Колонки.Добавить("КартинкаКонтакта");
	
	ТекущаяСтрокаТаблицыКонтактов = ЗагружаемыеКонтакты.Добавить();
	ТекущаяТаблицаКонтактов = ТекущаяСтрокаТаблицыКонтактов.Контакты;
	
	Для каждого ТекущийКонтакт Из МассивКонтактов Цикл
		
		ИмяКонтакта		= "";
		ИнфоКонтакта	= "";
		ФотоКонтакта	= "";
		
		Для каждого ТекЗапись Из ТекущийКонтакт Цикл
		
			Если СтрНайти(ТекЗапись, НачалоИмени) = 1 Тогда
				ТекЗапись = СтрЗаменить(ТекЗапись, НачалоИмени, "");
				КонвертироватьТекст(ТаблицаСимволов, ТекЗапись);
				ИмяКонтакта = СтрЗаменить(ТекЗапись, ТочкаСЗапятой, " ");
				Продолжить;
			КонецЕсли;
			
			Если СтрНайти(ТекЗапись, Фотография) > 0 Тогда
				ФотоКонтакта = ТекЗапись;
			ИначеЕсли НЕ ПустаяСтрока(ТекЗапись) Тогда
				КонвертироватьТекст(ТаблицаСимволов, ТекЗапись);
				ИнфоКонтакта = ИнфоКонтакта + ?(ПустаяСтрока(ИнфоКонтакта), "", ПереводСтроки) + ТекЗапись;
			КонецЕсли;
		
		КонецЦикла;
		
		НоваяСтрока = ТаблицаКонтактов.Добавить();
		НоваяСтрока.ИмяКонтакта  = ИмяКонтакта;
		НоваяСтрока.ИнфоКонтакта = ПроизвестиЗаменуКонтактныхДанныхНаСервереБезКонтекста(ТаблицаКонтактныхДанных, ИнфоКонтакта);
		НоваяСтрока.ФотоКонтакта = ФотоКонтакта;
		
		НоваяСтрока = ТекущаяТаблицаКонтактов.Добавить();
		НоваяСтрока.ИмяКонтакта = ИмяКонтакта;
		
	КонецЦикла;
	
	Для каждого СтрокаТаблицы Из ТаблицаКонтактов Цикл
		
		ФотоКонтакта = СтрокаТаблицы.ФотоКонтакта;
		
		Если ПустаяСтрока(ФотоКонтакта) Тогда
			Продолжить;
		КонецЕсли;
		
		ПозицияДвоеточия = СтрНайти(ФотоКонтакта, Двоеточие);
		
		Если ПозицияДвоеточия > 0 Тогда
			СтрокаBase64 = Сред(ФотоКонтакта, ПозицияДвоеточия + 1);
			ТекКартинка = Новый Картинка(Base64Значение(СтрокаBase64));
		Иначе
			ТекКартинка = ПустаяКартинка;
		КонецЕсли;
		
		СтрокаТаблицы.КартинкаКонтакта = ТекКартинка;
		
	КонецЦикла;
	
	ТаблицаКонтактов.Сортировать("ИмяКонтакта");
	
	ТабДокумент	= Новый ТабличныйДокумент;
	Макет		= РеквизитФормыВЗначение("Объект").ПолучитьМакет("ТаблицаКонтактов");
	
	Для каждого СтрокаТаблицы Из ТаблицаКонтактов Цикл
		
		ОбластьКонтакта = Макет.ПолучитьОбласть("ОбластьКонтакта");
		ОбластьКонтакта.Параметры.Заполнить(СтрокаТаблицы);
		
		Если СтрокаТаблицы.КартинкаКонтакта <> Неопределено Тогда
			ОбластьКонтакта.Рисунки.КартинкаКонтакта.Картинка = СтрокаТаблицы.КартинкаКонтакта;
		Иначе
			ОбластьКонтакта.Рисунки.Удалить(ОбластьКонтакта.Рисунки["КартинкаКонтакта"]);
		КонецЕсли;
		
		ТабДокумент.Вывести(ОбластьКонтакта);
		
		Если СтрокаТаблицы.КартинкаКонтакта = Неопределено Тогда
			ТабДокумент.Область(ТабДокумент.ВысотаТаблицы, , ТабДокумент.ВысотаТаблицы).АвтоВысотаСтроки = Истина
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТабДокумент;

КонецФункции

&НаСервере
Функция СравнитьФайлыVCFНаСервере()

	ТабДокумент = Новый ТабличныйДокумент;
	КоличествоСтрок = ЗагружаемыеКонтакты.Количество()-1;
	
	Если КоличествоСтрок < 1 Тогда
		Возврат ТабДокумент;
	КонецЕсли;
	
	Если ИндексПервойТаблицы > КоличествоСтрок
		ИЛИ ИндексВторойТаблицы > КоличествоСтрок
	Тогда
		Возврат ТабДокумент;
	КонецЕсли;
	
	ТаблицаКонтактов1 = ЗагружаемыеКонтакты[ИндексПервойТаблицы].Контакты.Выгрузить();
	ТаблицаКонтактов2 = ЗагружаемыеКонтакты[ИндексВторойТаблицы].Контакты.Выгрузить();
	
	ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаКонтактов1.ИмяКонтакта КАК ИмяКонтакта
		|ПОМЕСТИТЬ ТК1
		|ИЗ
		|	&ТаблицаКонтактов1 КАК ТаблицаКонтактов1
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаКонтактов2.ИмяКонтакта КАК ИмяКонтакта
		|ПОМЕСТИТЬ ТК2
		|ИЗ
		|	&ТаблицаКонтактов2 КАК ТаблицаКонтактов2
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЕСТЬNULL(ТК1.ИмяКонтакта, """") КАК ИмяКонтакта1,
		|	ЕСТЬNULL(ТК2.ИмяКонтакта, """") КАК ИмяКонтакта2,
		|	ЕСТЬNULL(ТК2.ИмяКонтакта, ТК1.ИмяКонтакта) КАК ПолеСортировки
		|ПОМЕСТИТЬ Данные
		|ИЗ
		|	ТК1 КАК ТК1
		|		ПОЛНОЕ СОЕДИНЕНИЕ ТК2 КАК ТК2
		|		ПО ТК1.ИмяКонтакта = ТК2.ИмяКонтакта
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Данные.ИмяКонтакта1 КАК ИмяКонтакта1,
		|	Данные.ИмяКонтакта2 КАК ИмяКонтакта2
		|ИЗ
		|	Данные КАК Данные
		|ГДЕ
		|	Данные.ИмяКонтакта1 <> Данные.ИмяКонтакта2
		|
		|УПОРЯДОЧИТЬ ПО
		|	Данные.ПолеСортировки";
	
	Запрос = Новый Запрос(ТекстЗапроса);
	Запрос.УстановитьПараметр("ТаблицаКонтактов1", ТаблицаКонтактов1);
	Запрос.УстановитьПараметр("ТаблицаКонтактов2", ТаблицаКонтактов2);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат ТабДокумент;
	КонецЕсли;
	
	Макет = РеквизитФормыВЗначение("Объект").ПолучитьМакет("СверяемыеКонтакты");
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ОбластьСтрока = Макет.ПолучитьОбласть("ОбластьСтрока");
		ОбластьСтрока.Параметры.Заполнить(Выборка);
		ТабДокумент.Вывести(ОбластьСтрока);
	КонецЦикла;

	Возврат ТабДокумент;
	
КонецФункции

&НаКлиенте
Процедура ЗаполнитьСписокВыбора(СписокВыбора)

	СписокВыбора.Очистить();
	
	КоличествоСтрок = ЗагружаемыеКонтакты.Количество()-1;
	
	Если КоличествоСтрок > 0 Тогда
		Элементы.ГруппаСверка.Видимость = Истина;
		ИндексВторойТаблицы = КоличествоСтрок;
	КонецЕсли;
	
	Для Сч = 0 По КоличествоСтрок Цикл
		СписокВыбора.Добавить(Сч, Сч);
	КонецЦикла;

КонецПроцедуры

#КонецОбласти
