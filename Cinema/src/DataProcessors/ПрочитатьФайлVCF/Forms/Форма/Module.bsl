
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиРеквизитовФормы

&НаКлиенте
Процедура ПутьИИмяФайлаVCFНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	НачалоВыбораФайлаVCF("ПутьИИмяФайлаVCF");
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПрочитатьФайлVCF(Команда)
	
	Если НЕ ПустаяСтрока(ПутьИИмяФайлаVCF) Тогда
		
		мФайл = Новый Файл(ПутьИИмяФайлаVCF);
		ОпОповещения = Новый ОписаниеОповещения("ПослеЗавершенияПроверкиСуществования", ЭтотОбъект, мФайл.Имя);
		
		мФайл.НачатьПроверкуСуществования(ОпОповещения);
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура СравнитьФайлыVCF(Команда)

	ТабДокумент = СравнитьФайлыVCFНаСервере();
	ТабДокумент.Показать();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаКлиенте
Процедура ПослеЗавершенияПроверкиСуществования(ФайлСуществует, ИмяСуществуещегоФайла) Экспорт

	Если ФайлСуществует Тогда
		
		ФайлVCF = Новый ТекстовыйДокумент;
		ФайлVCF.ИспользуемоеИмяФайла = ИмяСуществуещегоФайла;
		
		ОпОповещения = Новый ОписаниеОповещения("ПослеЗавершенияЧтенияФайла", ЭтотОбъект, ФайлVCF);
		
		ФайлVCF.НачатьЧтение(ОпОповещения, ПутьИИмяФайлаVCF, КодировкаТекста.ANSI);
		
	Иначе
		
		ПоказатьОповещениеПользователя(НСтр("ru = 'Файл не существует!'"), , ИмяСуществуещегоФайла, БиблиотекаКартинок.УдалитьНепосредственно);
		
	КонецЕсли;

КонецПроцедуры // ПослеЗавершенияПроверкиСуществования()

&НаКлиенте
Процедура НачалоВыбораФайлаVCF(ИмяРеквизита)

	Описание = Новый ОписаниеОповещения("ПослеВыбораФайла", ЭтотОбъект, ИмяРеквизита);
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Фильтр = "*.vcf|*.vcf";
	Диалог.Показать(Описание);

КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораФайла(ВыбранныеФайлы, ИмяРеквизита) Экспорт
	
	Если ТипЗнч(ВыбранныеФайлы) = Тип("Массив") И ВыбранныеФайлы.Количество() > 0 Тогда
		ЭтотОбъект[ИмяРеквизита] = ВыбранныеФайлы.Получить(0);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗавершенияЧтенияФайла(ЧтениеФайлаVCF) Экспорт

	Начало		= "BEGIN:VCARD";
	Окончание	= "END:VCARD";
	НомерВерсии	= "VERSION:";
	Равно		= "=";
	Пробел		= " ";
	ТочкаСЗпт	= ";";
	СтрокВФайле = ЧтениеФайлаVCF.КоличествоСтрок();
	Контакты	= Новый Массив;
	Карточка	= Новый Массив;
	
	Для ИндексСтроки = 1 По СтрокВФайле Цикл
	
		ТекСтрокаФайла = ЧтениеФайлаVCF.ПолучитьСтроку(ИндексСтроки);
		
		Если ПустаяСтрока(ТекСтрокаФайла) Тогда
			Продолжить;
		ИначеЕсли СтрНайти(ТекСтрокаФайла, НомерВерсии, НаправлениеПоиска.СНачала) = 1 Тогда
			Продолжить;
		ИначеЕсли СтрНайти(ТекСтрокаФайла, Начало, НаправлениеПоиска.СНачала) = 1 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТекСтрокаФайла = Окончание Тогда
			Контакты.Добавить(Карточка);
			Карточка = Новый Массив;
			Продолжить;
		КонецЕсли;
		
		ПервыйСимвол = Лев(ТекСтрокаФайла, 1);
		
		Если ПервыйСимвол = Равно ИЛИ ПервыйСимвол = Пробел ИЛИ ПервыйСимвол = ТочкаСЗпт Тогда
			// Это продолжение строки
			НаибольшийИндекс = Карточка.ВГраница();
			Карточка[НаибольшийИндекс] = Карточка[НаибольшийИндекс] + СокрЛП(Сред(ТекСтрокаФайла, 2));
		Иначе
			Карточка.Добавить(СокрЛП(ТекСтрокаФайла));
		КонецЕсли;
	
	КонецЦикла;
		
	УдалитьСлужебныеКонструкцииНаКлиентеНаСервереБезКонтекста(Контакты);
	
	ТабДокумент	= СформироватьТабличныйДокументНаСервере(Контакты);
	
	Если ОтображатьЗагруженныеДанные Тогда
		ТабДокумент.Показать(ЧтениеФайлаVCF.ИспользуемоеИмяФайла);
	КонецЕсли;
	
	ЗаполнитьСписокВыбора(Элементы.ИндексПервойТаблицы.СписокВыбора);
	ЗаполнитьСписокВыбора(Элементы.ИндексВторойТаблицы.СписокВыбора);

КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УдалитьСлужебныеКонструкцииНаКлиентеНаСервереБезКонтекста(МассивКонтактов)

	ДвойноеРавно	= "==";
	ЗнакРавно		= "=";
	ДвойнаяТочкаЗпт	= ";;";
	ТочкаСЗапятой	= ";";
	Фотография		= "PHOTO;";
	ТипКодировки1	= "CHARSET=UTF-8;ENCODING=QUOTED-PRINTABLE:";
	ТипКодировки2	= "ENCODING=QUOTED-PRINTABLE:";
	
	Для каждого ТекущийКонтакт Из МассивКонтактов Цикл
		
		НаибольшийИндекс = ТекущийКонтакт.ВГраница();
		
		Для ТекИндекс = 0 По НаибольшийИндекс Цикл
			
			ТекЗапись = ТекущийКонтакт[ТекИндекс];
			
			ЭтоФотография = СтрНайти(ТекЗапись, Фотография) = 1;
			
			Если СтрНайти(ТекЗапись, ТипКодировки1) > 0 Тогда
				ТекЗапись = СтрЗаменить(ТекЗапись, ТипКодировки1, "");
			КонецЕсли;
			
			Если СтрНайти(ТекЗапись, ТипКодировки2) > 0 Тогда
				ТекЗапись = СтрЗаменить(ТекЗапись, ТипКодировки2, "");
			КонецЕсли;
			
			Если СтрНайти(ТекЗапись, ДвойноеРавно) > 0 И НЕ ЭтоФотография Тогда
				Пока СтрНайти(ТекЗапись, ДвойноеРавно) > 0 Цикл
					ТекЗапись = СтрЗаменить(ТекЗапись, ДвойноеРавно, ЗнакРавно);
				КонецЦикла;
			КонецЕсли;			
		
			Если СтрНайти(ТекЗапись, ДвойнаяТочкаЗпт) > 0 И НЕ ЭтоФотография Тогда
				Пока СтрНайти(ТекЗапись, ДвойнаяТочкаЗпт) > 0 Цикл
					ТекЗапись = СтрЗаменить(ТекЗапись, ДвойнаяТочкаЗпт, ТочкаСЗапятой);
				КонецЦикла;
			КонецЕсли;
			
			Если Прав(ТекЗапись, 1) = ТочкаСЗапятой Тогда
				ТекЗапись = Лев(ТекЗапись, СтрДлина(ТекЗапись)-1);
			КонецЕсли;
			
			Если Прав(ТекЗапись, 1) = ЗнакРавно И НЕ ЭтоФотография Тогда
				ТекЗапись = Лев(ТекЗапись, СтрДлина(ТекЗапись)-1);
			КонецЕсли;
			
			ТекущийКонтакт[ТекИндекс] = ТекЗапись;
			
		КонецЦикла;
		
	КонецЦикла;

КонецПроцедуры

