&НаКлиенте
Процедура ЗакрытьФормуНаКлиенте()

	ЭтотОбъект.Закрыть();

КонецПроцедуры // ЗакрытьФормуНаКлиенте()

&НаКлиенте
Процедура КонструкторЗапросаНаКлиенте()

	#Если ТолстыйКлиентУправляемоеПриложение Тогда
		мКонструкторЗапроса = Новый КонструкторЗапроса;
		Если мКонструкторЗапроса.ОткрытьМодально() Тогда
			ТекстЗапроса = мКонструкторЗапроса.Текст;
			Если НЕ ПустаяСтрока(ТекстЗапроса) Тогда
				ДобавитьЗапросВНачалоНаКлиенте(ТекстЗапроса);
			КонецЕсли;
		КонецЕсли;
	#Иначе
		ОписаниеОповещенияОЗакрытии = Новый ОписаниеОповещения("ПослеЗакрытияДиалогаКонструктораЗапроса", ЭтотОбъект);
		мКонструкторЗапроса = Новый КонструкторЗапроса;
		мКонструкторЗапроса.Показать(ОписаниеОповещенияОЗакрытии);
	#КонецЕсли

КонецПроцедуры // КонструкторЗапросаНаКлиенте()

&НаКлиенте
Процедура ПослеЗакрытияДиалогаКонструктораЗапроса(ТекстЗапроса, ДополнительныеПараметры) Экспорт

	Если ТекстЗапроса <> Неопределено И НЕ ПустаяСтрока(ТекстЗапроса) Тогда
		ДобавитьЗапросВНачалоНаКлиенте(ТекстЗапроса);
	КонецЕсли;

КонецПроцедуры // ПослеЗакрытияДиалогаКонструктораЗапроса()

&НаКлиенте
Процедура УдалитьСимволНаКлиенте(мСимвол = "")
	
	Если ПустаяСтрока(мСимвол) Тогда
		Возврат;
	КонецЕсли;

	ВыделенныйТекст = Элементы.ПолеВводаФрагментКода.ВыделенныйТекст;
	ВесьТекст		= ЭтотОбъект.ФрагментКода;

	Если ПустаяСтрока(ВыделенныйТекст) Тогда
		ЭтотОбъект.ФрагментКода = СтрЗаменить(ВесьТекст, мСимвол, "");
	Иначе
		ЭтотОбъект.ФрагментКода = СтрЗаменить(ВесьТекст, ВыделенныйТекст, СтрЗаменить(ВыделенныйТекст, мСимвол, ""));
	КонецЕсли;

КонецПроцедуры // УдалитьСимволНаКлиенте()

&НаКлиенте
Процедура ДобавитьСимволНаКлиенте(мСимвол)

	ВыделенныйТекст = Элементы.ПолеВводаФрагментКода.ВыделенныйТекст;
	ВесьТекст		= ЭтотОбъект.ФрагментКода;
	
	Если ПустаяСтрока(ВыделенныйТекст) Тогда
		КомментируемыйТекст = ВесьТекст;
	Иначе
		КомментируемыйТекст = ВыделенныйТекст;
	КонецЕсли;
	
	КоличествоСтрокТекста	= СтрЧислоСтрок(КомментируемыйТекст);
	ТекстСКомментариями		= "";
	Для Сч = 1 По КоличествоСтрокТекста Цикл
		ТекстСКомментариями = ТекстСКомментариями + мСимвол + СтрПолучитьСтроку(КомментируемыйТекст, Сч) + Символы.ПС;
	КонецЦикла;
	
	Если ПустаяСтрока(ВыделенныйТекст) Тогда
		ЭтотОбъект.ФрагментКода = ТекстСКомментариями;
	Иначе
		ЭтотОбъект.ФрагментКода = СтрЗаменить(ЭтотОбъект.ФрагментКода, ВыделенныйТекст, ТекстСКомментариями);
	КонецЕсли;

КонецПроцедуры // ДобавитьСимволНаКлиенте()

&НаКлиенте
Процедура УдалитьКомментарийНаКлиенте()
	
	УдалитьСимволНаКлиенте("//");
	
КонецПроцедуры // УдалитьКомментарийНаКлиенте()

&НаКлиенте
Процедура ДобавитьКомментарийНаКлиенте()
	
	ДобавитьСимволНаКлиенте("//");
	
КонецПроцедуры // ДобавитьКомментарийНаКлиенте()

&НаКлиенте
Процедура ДобавитьПереносСтрокиНаКлиенте()

	ДобавитьСимволНаКлиенте("|");

КонецПроцедуры // ДобавитьПереносСтрокиНаКлиенте()

&НаКлиенте
Процедура УдалитьПереносСтрокиНаКлиенте()

	УдалитьСимволНаКлиенте("|");

КонецПроцедуры // УдалитьПереносСтрокиНаКлиенте()

&НаКлиенте
Процедура ВыполнитьФрагментКодаНаКлиенте()

	мФрагментКода = ЭтотОбъект.ФрагментКода;
	
	Если ПустаяСтрока(мФрагментКода) Тогда
		ПоказатьОповещениеПользователя("Отсутствует выполняемый код", , "В поле ввода отсутствует код!", КартинкаВнимание32);
	КонецЕсли;
	
	Отказ = Ложь;
	
	Если ЭтотОбъект.ВыполнитьНаКлиенте Тогда
		Попытка
		    Выполнить(мФрагментКода);
		Исключение
			Отказ = Истина;
			Сообщить(ОписаниеОшибки());
		КонецПопытки;
	Иначе
		ВыполнитьФрагментКодаНаСервере(мФрагментКода, Отказ);
	КонецЕсли;
	
	Если Отказ Тогда
		ПоказатьОповещениеПользователя("Результат:", , "Ошибка выполнения кода!", КартинкаОшибка32);
	Иначе
		ПоказатьОповещениеПользователя("Результат:", , "Код выполнен успешно!", КартинкаВыполненоУспешно32);
	КонецЕсли;

КонецПроцедуры // ВыполнитьФрагментКодаНаСервере()

&НаСервереБезКонтекста
Процедура ВыполнитьФрагментКодаНаСервере(ФрагментКода, Отказ)

	Попытка
	    Выполнить(ФрагментКода);
	Исключение
		Отказ = Истина;
		Сообщить(ОписаниеОшибки());
	КонецПопытки;

КонецПроцедуры // ВыполнитьФрагментКодаНаСервере()

&НаКлиенте
Процедура ДобавитьЗапросВНачалоНаКлиенте(мТекстЗапроса)

	ПараметрыЗапроса	= "";
	мТекстЗапроса		= СтрЗаменить(мТекстЗапроса, """", """""");
	
	ФрагментКогда = "Запрос = Новый Запрос(" + Символы.ПС + Символы.Таб + """";
	
	ЧислоСтрок = СтрЧислоСтрок(мТекстЗапроса);
	
	Для Сч = 1 По ЧислоСтрок Цикл
		
		Если Сч > 1 Тогда
			ФрагментКогда = ФрагментКогда + Символы.Таб + "|";
		КонецЕсли;
		
		текСтрока = СтрПолучитьСтроку(мТекстЗапроса, Сч);
		
		ФрагментКогда = ФрагментКогда + текСтрока;
		
		Если НЕ Найти(текСтрока, "&") = 0 Тогда
			ДобавитьПараметрыЗапроса(текСтрока, ПараметрыЗапроса);
		КонецЕсли;		
		
		Если НЕ Сч = ЧислоСтрок Тогда
			ФрагментКогда = ФрагментКогда + Символы.ПС;
		КонецЕсли;
	
	КонецЦикла;
	
	ФрагментКогда = ФрагментКогда + """);";
	
	Если Не ПустаяСтрока(ПараметрыЗапроса) Тогда
		ФрагментКогда = ФрагментКогда + Символы.ПС + Символы.ПС + ПараметрыЗапроса;
	КонецЕсли;
	
	ФрагментКогда = ФрагментКогда + Символы.ПС + "Выборка = Запрос.Выполнить().Выбрать();" + Символы.ПС
					+ "Пока Выборка.Следующий() Цикл" + Символы.ПС + "КонецЦикла;";
	
	ВесьТекст = ЭтотОбъект.ФрагментКода;
	Если ПустаяСтрока(ВесьТекст) Тогда
		ЭтотОбъект.ФрагментКода = ФрагментКогда;
	Иначе
		ТекстВопроса = "Поле ""Фрагмент кода"" не пустое." + Символы.ПС + "Заменить текстом запроса?";
		ПоказатьВопрос(Новый ОписаниеОповещения("ПослеЗакрытияОкнаВводаЗначения", ЭтотОбъект, Новый Структура("ФрагментКогда, ВесьТекст", ФрагментКогда, ВесьТекст)), ТекстВопроса, РежимДиалогаВопрос.ДаНет, 60, КодВозвратаДиалога.Нет, , КодВозвратаДиалога.Нет);
	КонецЕсли;
	
КонецПроцедуры // ДобавитьЗапросВНачалоНаКлиенте()

&НаКлиенте
Процедура ПослеЗакрытияОкнаВводаЗначения(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ЭтотОбъект.ФрагментКода = ДополнительныеПараметры.ФрагментКогда;
	Иначе
		ЭтотОбъект.ФрагментКода = ДополнительныеПараметры.ФрагментКогда + Символы.ПС + "//////////////////////" + Символы.ПС + ДополнительныеПараметры.ВесьТекст;
	КонецЕсли;
		
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьПараметрыЗапроса(текСтрока, ПараметрыЗапроса)
	
	Амперсенд = Найти(текСтрока, "&");
	
	тПараметр = Сред(текСтрока, Амперсенд + 1);
	
	ПараметрыЗапроса = ПараметрыЗапроса + "Запрос.УстановитьПараметр(""" + тПараметр + """, " + тПараметр + ");" + Символы.ПС;

КонецПроцедуры // ДобавитьПараметрыЗапроса()

&НаКлиенте
Процедура ПослеЗакрытияОкнаВводаСтроки(ВведенноеЗначение, ДополнительныеПараметры) Экспорт

	Если ВведенноеЗначение <> Неопределено Тогда
		
		ВыбранныйШаблон			= ДополнительныеПараметры.ВыбранныйШаблон;
		мВыражениеПоУмолчанию	= "<" + ДополнительныеПараметры.ВыражениеПоУмолчанию + ">";
		ДобавляемаяСтрока		= "";
	
		Если ПустаяСтрока(ВведенноеЗначение) Тогда
			мВведенноеЗначение = мВыражениеПоУмолчанию;
		Иначе
			мВведенноеЗначение = ВведенноеЗначение;
		КонецЕсли;
		
		Если ВыбранныйШаблон = "Если" Тогда
			ДобавляемаяСтрока = "Если " + мВведенноеЗначение + " Тогда" + Символы.ПС + "КонецЕсли;" + Символы.ПС;
		ИначеЕсли ВыбранныйШаблон = "ЕслиИначе" Тогда
			ДобавляемаяСтрока = "Если " + мВведенноеЗначение + " Тогда" + Символы.ПС + "Иначе" + Символы.ПС + "КонецЕсли;" + Символы.ПС;
		ИначеЕсли ВыбранныйШаблон = "Пока" Тогда
			ДобавляемаяСтрока = "Пока " + мВведенноеЗначение + " Цикл" + Символы.ПС + "КонецЦикла;" + Символы.ПС;
		ИначеЕсли ВыбранныйШаблон = "Для" Тогда
			ДобавляемаяСтрока = "Для Сч = 1 По " + мВведенноеЗначение + " Цикл" + Символы.ПС + "КонецЦикла;" + Символы.ПС;
		ИначеЕсли ВыбранныйШаблон = "ДляКаждого" Тогда
			ПервоеВведенноеЗначение = "";
			Если ДополнительныеПараметры.Свойство("ПервоеВведенноеЗначение", ПервоеВведенноеЗначение) Тогда
				ДобавляемаяСтрока = "Для каждого " + ПервоеВведенноеЗначение + " Из " + мВведенноеЗначение + " Цикл" + Символы.ПС + "КонецЦикла;" + Символы.ПС;
			Иначе
				ДополнительныеПараметры.Вставить("ПервоеВведенноеЗначение", мВведенноеЗначение);
				ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПослеЗакрытияОкнаВводаСтроки", ЭтотОбъект, ДополнительныеПараметры);
				ПоказатьВводСтроки(ОписаниеОповещенияОЗавершении, "Коллекция", "Коллекция", , Ложь);
				Возврат;
			КонецЕсли;
		КонецЕсли;			
	
		ЭтотОбъект.ФрагментКода = ДополнительныеПараметры.ФрагментКогда + ДобавляемаяСтрока;
		Если НЕ ЭтотОбъект.Модифицированность Тогда
			ЭтотОбъект.Модифицированность = Истина;
		КонецЕсли;

	КонецЕсли;

КонецПроцедуры // ПолучитьВыражениеПользователя()

&НаКлиенте
Процедура ДобавитьШаблонТекстаНаКлиенте(Команда)
	
	ОписаниеОповещенияОЗакрытии = Новый ОписаниеОповещения("ПослеЗакрытияДиалогаВыбораЭлемента", ЭтотОбъект);
	ШаблоныТекста.ПоказатьВыборЭлемента(ОписаниеОповещенияОЗакрытии, , ШаблоныТекста[0]);
	
КонецПроцедуры // ДобавитьШаблонТекстаНаКлиенте()

&НаКлиенте
Процедура ПослеЗакрытияДиалогаВыбораЭлемента(ВыбранныйЭлемент, ДополнительныйПараметр) Экспорт

	Если НЕ ВыбранныйЭлемент = Неопределено Тогда
		
		ВыбранныйШаблон = ВыбранныйЭлемент.Значение;
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ДобавляемаяСтрока", "");
		ДополнительныеПараметры.Вставить("ФрагментКогда", ЭтотОбъект.ФрагментКода);
		ДополнительныеПараметры.Вставить("ВыбранныйШаблон", ВыбранныйШаблон);
		
		Подсказка = "Условие";
		ВыражениеПоУмолчанию = "Выражение";
		
		Если ВыбранныйШаблон = "Для" Тогда
			Подсказка = "Ограничение";
			ВыражениеПоУмолчанию = "Ограничение";
		ИначеЕсли ВыбранныйШаблон = "ДляКаждого" Тогда
			Подсказка = "Переменная";
			ВыражениеПоУмолчанию = "Переменная";
		КонецЕсли;
		
		ДополнительныеПараметры.Вставить("ВыражениеПоУмолчанию", ВыражениеПоУмолчанию);
		
		ОписаниеОповещенияОЗавершении = Новый ОписаниеОповещения("ПослеЗакрытияОкнаВводаСтроки", ЭтотОбъект, ДополнительныеПараметры);
		
		ПоказатьВводСтроки(ОписаниеОповещенияОЗавершении, ВыражениеПоУмолчанию, Подсказка, , Ложь);
		
	КонецЕсли;

КонецПроцедуры // ПослеЗакрытияДиалогаВыбораЭлемента()

&НаКлиенте
Процедура ПроинициализироватьПеременные()

	КартинкаВнимание32			= ПолучитьКартинкуИзМакетаНаСервере("Внимание32");
	КартинкаОшибка32			= ПолучитьКартинкуИзМакетаНаСервере("Ошибка32");
	КартинкаИнформация32		= ПолучитьКартинкуИзМакетаНаСервере("Информация32");
	КартинкаВыполненоУспешно32	= ПолучитьКартинкуИзМакетаНаСервере("ВыполненоУспешно32");

	ШаблоныТекста = Новый СписокЗначений;
	ШаблоныТекста.Добавить("Если", "Если (Если)");
	ШаблоныТекста.Добавить("ЕслиИначе", "ЕслиИначе (Если)");
	ШаблоныТекста.Добавить("Пока", "Пока (Пока)");
	ШаблоныТекста.Добавить("Для", "Для (Для)");
	ШаблоныТекста.Добавить("ДляКаждого", "Для каждого (Для[ Каждого])");

КонецПроцедуры // ПроинициализироватьПеременные()

