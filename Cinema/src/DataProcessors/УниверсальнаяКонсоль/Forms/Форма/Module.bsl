&НаСервере
Процедура УстановитьЗаголовокФормы()
	
	ЭтотОбъект.АвтоЗаголовок = Ложь;
	ЭтотОбъект.Заголовок = РеквизитФормыВЗначение("Объект").Метаданные().Синоним;
	
КонецПроцедуры // ПолучитьЗаголовокФормы()

&НаСервере
Функция ПолучитьКартинкуИзМакетаНаСервере(ИмяМакета)

	ДвоичныеДанные = РеквизитФормыВЗначение("Объект").ПолучитьМакет(ИмяМакета);
	
	Картинка = Новый Картинка(ДвоичныеДанные);
	
	Возврат Картинка;

КонецФункции // ПолучитьКартинкуИзМакетаНаСервере()

