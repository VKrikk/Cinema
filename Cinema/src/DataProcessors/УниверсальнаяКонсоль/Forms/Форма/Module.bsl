&НаСервере
Функция ДобавитьКнопкуНаФорму(Родитель, ИмяКнопкиФормы, ИмяКоманды, мЗаголовок = "Кнопка", Картинка = Неопределено)

	мКнопкаФормы = Элементы.Добавить(ИмяКнопкиФормы, Тип("КнопкаФормы"), Родитель);
	мКнопкаФормы.Заголовок	= мЗаголовок;
	мКнопкаФормы.ИмяКоманды	= ИмяКоманды;
	Если ТипЗнч(Картинка) = Тип("Картинка") Тогда
		мКнопкаФормы.Отображение = ОтображениеКнопки.КартинкаИТекст;
		мКнопкаФормы.Картинка	= Картинка;
	КонецЕсли;
	
	Возврат мКнопкаФормы;

КонецФункции // ДобавитьКнопкуНаФорму()

&НаСервере
Функция ДобавитьКомандуФормы(ИмяКоманды, ИмяПроцедурыОбработчика, мЗаголовок = "Команда")

	мКомандаФормы = Команды.Добавить(ИмяКоманды);
	мКомандаФормы.Действие	= ИмяПроцедурыОбработчика;
	мКомандаФормы.Заголовок	= мЗаголовок;
	
	Возврат мКомандаФормы;

КонецФункции // ДобавитьКомандуФормы()

&НаСервере
Функция ДобавитьРеквизитФормы(ИмяРеквизита, ТипРеквизита)

    мРеквизитФормы = Новый РеквизитФормы(ИмяРеквизита, ТипРеквизита);
	
	Возврат мРеквизитФормы;

КонецФункции // ДобавитьРеквизитФормы()

&НаСервере
Функция ДобавитьПолеВводаНаФорму(Родитель, ИмяЭлемента, ТипЭлемента, ВидПоля, ПутьКДанным, ПоложениеЗаголовка)

    мПолеВвода = Элементы.Добавить(ИмяЭлемента, ТипЭлемента, Родитель);
    мПолеВвода.Вид = ВидПоля;
	мПолеВвода.ПутьКДанным = ПутьКДанным;
	мПолеВвода.ПоложениеЗаголовка = ПоложениеЗаголовка;
	
	Возврат мПолеВвода;

КонецФункции // ДобавитьПолеВводаНаФорму()
