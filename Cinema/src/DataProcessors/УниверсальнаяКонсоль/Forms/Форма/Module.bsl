&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Заголовок
	УстановитьЗаголовокФормы();
	
	мКоманднаяПанель = Элементы.ФормаКоманднаяПанель;
	
	// Команды формы
	КомандаВыполнитьФрагментКода	= ДобавитьКомандуФормы("КомандаВыполнитьФрагментКода", "ВыполнитьФрагментКодаНаКлиенте", "Выполнить фрагмент кода");
	КомандаДобавитьКомментарий		= ДобавитьКомандуФормы("КомандаДобавитьКомментарий", "ДобавитьКомментарийНаКлиенте", "Добавить комментарий");
	КомандаУдалитьКомментарий		= ДобавитьКомандуФормы("КомандаУдалитьКомментарий", "УдалитьКомментарийНаКлиенте", "Удалить комментарий");
	КомандаКонструкторЗапроса		= ДобавитьКомандуФормы("КомандаКонструкторЗапроса", "КонструкторЗапросаНаКлиенте", "Конструктор запроса");
	КомандаЗакрытьФорму				= ДобавитьКомандуФормы("КомандаЗакрытьФорму", "ЗакрытьФормуНаКлиенте", "Закрыть");
	КомандаДобавитьПереносСтроки	= ДобавитьКомандуФормы("КомандаДобавитьПереносСтроки", "ДобавитьПереносСтрокиНаКлиенте", "Добавить перенос строки");
	КомандаУдалитьПереносСтроки		= ДобавитьКомандуФормы("КомандаУдалитьПереносСтроки", "УдалитьПереносСтрокиНаКлиенте", "Удалить перенос строки");
	КомандаДобавитьШаблонТекста		= ДобавитьКомандуФормы("КомандаДобавитьШаблонТекста", "ДобавитьШаблонТекстаНаКлиенте", "Добавить шаблон текста");
	
	// Первая кнопка формы
	КнопкаВыполнитьФрагментКода = ДобавитьКнопкуНаФорму(мКоманднаяПанель, "КнопкаВыполнитьФрагментКода", "КомандаВыполнитьФрагментКода",
														"Выполнить фрагмент кода", БиблиотекаКартинок.СформироватьОтчет);
	// Группы кнопок
	ГруппаКнопокКомментарий				= Элементы.Добавить("ГруппаКнопокКомментарий", Тип("ГруппаФормы"), мКоманднаяПанель);
	ГруппаКнопокКомментарий.Вид			= ВидГруппыФормы.Подменю;	
	ГруппаКнопокКомментарий.Заголовок	= "Комментарий";
	
	ГруппаКнопокПереносСтроки			= Элементы.Добавить("ГруппаКнопокПереносСтроки", Тип("ГруппаФормы"), мКоманднаяПанель);
	ГруппаКнопокПереносСтроки.Вид		= ВидГруппыФормы.Подменю;	
	ГруппаКнопокПереносСтроки.Заголовок	= "Перенос строки";

	// Кнопки формы
	КнопкаДобавитьКомментарий	= ДобавитьКнопкуНаФорму(ГруппаКнопокКомментарий, "КнопкаДобавитьКомментарий", "КомандаДобавитьКомментарий", "Добавить комментарий");
	КнопкаУдалитьКомментарий	= ДобавитьКнопкуНаФорму(ГруппаКнопокКомментарий, "КнопкаУдалитьКомментарий", "КомандаУдалитьКомментарий", "Удалить комментарий");
	КнопкаДобавитьПереносСтроки	= ДобавитьКнопкуНаФорму(ГруппаКнопокПереносСтроки, "КнопкаДобавитьПереносСтроки", "КомандаДобавитьПереносСтроки", "Добавить перенос строки");
	КнопкаУдалитьПереносСтроки	= ДобавитьКнопкуНаФорму(ГруппаКнопокПереносСтроки, "КнопкаУдалитьПереносСтроки", "КомандаУдалитьПереносСтроки", "Удалить перенос строки");
	КнопкаКонструкторЗапроса	= ДобавитьКнопкуНаФорму(мКоманднаяПанель, "КнопкаКонструкторЗапроса", "КомандаКонструкторЗапроса", "Конструктор запроса", БиблиотекаКартинок.КонструкторЗапроса);
	КнопкаКомандаДобавитьШаблонТекста = ДобавитьКнопкуНаФорму(мКоманднаяПанель, "КнопкаКомандаДобавитьШаблонТекста", "КомандаДобавитьШаблонТекста", "Шаблоны текста");
	КнопкаЗакрытьФорму			= ДобавитьКнопкуНаФорму(мКоманднаяПанель, "КнопкаЗакрытьФорму", "КомандаЗакрытьФорму", "Закрыть", БиблиотекаКартинок.Закрыть);
	
	// Реквизиты формы
    ДобавляемыеРеквизиты = Новый Массив;
    РеквизитФрагментКода = ДобавитьРеквизитФормы("ФрагментКода", Новый ОписаниеТипов("Строка"));
    ДобавляемыеРеквизиты.Добавить(РеквизитФрагментКода);
	ДобавляемыеРеквизиты.Добавить(Новый РеквизитФормы("ВыполнитьНаКлиенте", Новый ОписаниеТипов("Булево"), , НСтр("ru = 'Выполнить на клиенте'")));
    ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	// Элементы формы
    ЭлементФрагментКода = ДобавитьПолеВводаНаФорму(ЭтотОбъект, "ПолеВводаФрагментКода", Тип("ПолеФормы"),
													ВидПоляФормы.ПолеТекстовогоДокумента, "ФрагментКода", ПоложениеЗаголовкаЭлементаФормы.Нет);
	ЭлементФрагментКода.УстановитьДействие("ПриИзменении", "ПриИзмененииФрагментаКода");
	
	ВыполнитьНаКлиентеНаСервере = ДобавитьПолеВводаНаФорму(ЭтотОбъект, "ВыполнитьНаКлиенте", Тип("ПолеФормы"),
													ВидПоляФормы.ПолеФлажка, "ВыполнитьНаКлиенте", ПоложениеЗаголовкаЭлементаФормы.Право);
	
	// События формы
	УстановитьДействие("ПередЗакрытием", "ПередЗакрытием");
	УстановитьДействие("ПриОткрытии", "ПриОткрытии");
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииФрагментаКода()

	ЭтотОбъект.Модифицированность = Истина;

КонецПроцедуры // ПриИзмененииФрагментаКода()

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	ТекстВопроса = НСтр("ru = 'Код в окне был изменен. Продолжить?'");
	
	Если ЗавершениеРаботы = Неопределено И ТекстПредупреждения = Неопределено Тогда
		
		// Версия ниже 8.3.8
		Если ЗакрытиеРазрешено = Неопределено И ЭтотОбъект.Модифицированность Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект), ТекстВопроса, РежимДиалогаВопрос.ДаНет);
			Отказ = Истина;
		КонецЕсли;

	Иначе
	
		Если ЗавершениеРаботы И ЭтотОбъект.Модифицированность Тогда
			ТекстПредупреждения = ТекстВопроса;
			Отказ = Истина;
		ИначеЕсли ЗакрытиеРазрешено = Неопределено И ЭтотОбъект.Модифицированность Тогда
			ПоказатьВопрос(Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект), ТекстВопроса, РежимДиалогаВопрос.ДаНет);
			Отказ = Истина;
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
    Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ЗакрытиеРазрешено = Истина;
		Закрыть();			
    КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ПроинициализироватьПеременные();

КонецПроцедуры

