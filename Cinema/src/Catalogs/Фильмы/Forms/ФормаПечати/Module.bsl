	СтруктураЗамены.Вставить("ДатаРелиза",		"<!--DateRelease-->");
	СтруктураЗамены.Вставить("ДатаСкачивания",	"<!--DateDownload-->");
	СтруктураЗамены.Вставить("РазмерФайла",		"<!--%Size%-->");
	СтруктураЗамены.Вставить("Аннотация",		"<!--Annotation-->");
	СтруктураЗамены.Вставить("Комментарий",		"<!--Comment-->");
	СтруктураЗамены.Вставить("ИмяФайла",		"<!--FileName-->");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СписокФильмов", СписокФильмов.ВыгрузитьЗначения());
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Фильмы.Ссылка КАК Фильм,
		|	Фильмы.Наименование + ВЫБОР
		|		КОГДА Фильмы.ОригинальноеНазвание = """"
		|			ТОГДА """"
		|		ИНАЧЕ "" ("" + Фильмы.ОригинальноеНазвание + "")""
		|	КОНЕЦ + ВЫБОР
		|		КОГДА Фильмы.Формат3D
		|			ТОГДА "" 3D""
		|		ИНАЧЕ """"
		|	КОНЕЦ КАК Наименование,
		|	Фильмы.ДатаВыхода КАК ДатаВыхода,
		|	ВЫБОР
		|		КОГДА Фильмы.ЦифровойРелиз = ДАТАВРЕМЯ(1, 1, 1)
		|			ТОГДА ""---""
		|		ИНАЧЕ Фильмы.ЦифровойРелиз
		|	КОНЕЦ КАК ДатаРелиза,
		|	ЕСТЬNULL(ДатыСкачиванияФильмов.ДатаСкачивания, ""---"") КАК ДатаСкачивания,
		|	Фильмы.Афиша КАК Афиша,
		|	ВЫБОР
		|		КОГДА ДатыСкачиванияФильмов.ДатаСкачивания ЕСТЬ NULL
		|			ТОГДА ВЫБОР
		|					КОГДА Фильмы.ЦифровойРелиз = ДАТАВРЕМЯ(1, 1, 1)
		|						ТОГДА Фильмы.ДатаВыхода
		|					ИНАЧЕ Фильмы.ЦифровойРелиз
		|				КОНЕЦ
		|		ИНАЧЕ ДатыСкачиванияФильмов.ДатаСкачивания
		|	КОНЕЦ КАК ПравилоСортировки,
		|	Фильмы.РазмерФайла КАК РазмерФайла,
		|	Фильмы.ИмяФайла КАК ИмяФайла,
		|	Фильмы.Комментарий КАК Комментарий
		|ПОМЕСТИТЬ Фильмы
		|ИЗ
		|	Справочник.Фильмы КАК Фильмы
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыСкачиванияФильмов КАК ДатыСкачиванияФильмов
		|		ПО Фильмы.Ссылка = ДатыСкачиванияФильмов.Фильм
		|ГДЕ
		|	НЕ Фильмы.ПометкаУдаления
		|	И Фильмы.Ссылка В(&СписокФильмов)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Аннотации.Владелец КАК Фильм,
		|	ВЫРАЗИТЬ(Аннотации.СодержаниеАннотации КАК СТРОКА(999)) КАК Аннотация
		|ИЗ
		|	Справочник.Аннотации КАК Аннотации
		|ГДЕ
		|	Аннотации.Владелец В
		|			(ВЫБРАТЬ
		|				Фильмы.Фильм КАК Фильм
		|			ИЗ
		|				Фильмы КАК Фильмы)
		|	И НЕ Аннотации.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Фильм
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтраныПроизводители.Фильм КАК Фильм,
		|	СтраныПроизводители.Страна.Представление КАК Страна
		|ИЗ
		|	РегистрСведений.СтраныПроизводители КАК СтраныПроизводители
		|ГДЕ
		|	СтраныПроизводители.Фильм В
		|			(ВЫБРАТЬ
		|				Фильмы.Фильм КАК Фильм
		|			ИЗ
		|				Фильмы КАК Фильмы)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Фильм
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЖанрыФильмов.Фильм КАК Фильм,
		|	ЖанрыФильмов.Жанр.Представление КАК Жанр
		|ИЗ
		|	РегистрСведений.ЖанрыФильмов КАК ЖанрыФильмов
		|ГДЕ
		|	ЖанрыФильмов.Фильм В
		|			(ВЫБРАТЬ
		|				Фильмы.Фильм КАК Фильм
		|			ИЗ
		|				Фильмы КАК Фильмы)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Фильм
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Фильмы.Фильм КАК Фильм,
		|	Фильмы.Наименование КАК Наименование,
		|	Фильмы.ДатаВыхода КАК ДатаВыхода,
		|	Фильмы.ДатаРелиза КАК ДатаРелиза,
		|	Фильмы.ДатаСкачивания КАК ДатаСкачивания,
		|	Фильмы.Афиша КАК Афиша,
		|	Фильмы.ПравилоСортировки КАК ПравилоСортировки,
		|	Фильмы.РазмерФайла КАК РазмерФайла,
		|	Фильмы.ИмяФайла КАК ИмяФайла,
		|	Фильмы.Комментарий КАК Комментарий
		|ИЗ
		|	Фильмы КАК Фильмы
		|
		|УПОРЯДОЧИТЬ ПО
		|	ПравилоСортировки УБЫВ";
	
	РезультатыЗапроса = Запрос.ВыполнитьПакет();
	НаибольшийИндекс  = РезультатыЗапроса.ВГраница();
	ВыборкаПоФильмам  = РезультатыЗапроса.Получить(НаибольшийИндекс).Выбрать();
	СтруктураПолей    = Новый Структура("Жанр, Страна, Аннотация", "", "", "");
	СтруктураПоиска   = Новый Структура("Фильм");
	ФайлHTML          = "";
	ТипКартинка       = Тип("Картинка");
	
	Пока ВыборкаПоФильмам.Следующий() Цикл
	
		ЗаполнитьЗначенияСвойств(СтруктураПоиска, ВыборкаПоФильмам);
		ТекущийИндекс = НаибольшийИндекс;
	
		Для каждого КлючИЗначение Из СтруктураПолей Цикл
			
			ТекущийИндекс   = ТекущийИндекс - 1;
			Выборка         = РезультатыЗапроса.Получить(ТекущийИндекс).Выбрать();
			ТекЗначение		= "";
			
			СтруктураПолей[КлючИЗначение.Ключ] = ТекЗначение;
			Пока Выборка.НайтиСледующий(СтруктураПоиска) Цикл
				ТекЗначение = ТекЗначение + ?(ПустаяСтрока(ТекЗначение), "", ", ") + Выборка[КлючИЗначение.Ключ];
			КонецЦикла;
			СтруктураПолей[КлючИЗначение.Ключ] = ?(ПустаяСтрока(ТекЗначение), "---", ТекЗначение);
			 
		КонецЦикла;
		
		ЗаполняемыйШаблонHTML = ШаблонHTML;
		
		Для каждого КлючИЗначение Из СтруктураЗамены Цикл
			Если СтруктураПолей.Свойство(КлючИЗначение.Ключ) Тогда
				ЗаполняемыйШаблонHTML = СтрЗаменить(ЗаполняемыйШаблонHTML, КлючИЗначение.Значение, СтруктураПолей[КлючИЗначение.Ключ]);
			Иначе
				ЗаполняемыйШаблонHTML = СтрЗаменить(ЗаполняемыйШаблонHTML, КлючИЗначение.Значение, ВыборкаПоФильмам[КлючИЗначение.Ключ]);
			КонецЕсли;
		КонецЦикла;
			
		Афиша = ВыборкаПоФильмам.Афиша.Получить();
		Если ТипЗнч(Афиша) = ТипКартинка Тогда
			Строка64 = Base64Строка(Афиша.ПолучитьДвоичныеДанные());
			Расширение = НРег(Афиша.Формат());
			ЗаполняемыйШаблонHTML = СтрЗаменить(ЗаполняемыйШаблонHTML, "<!--Poster-->", СтрШаблон("<img src=""data:image/%1;base64,%2"" width=""250"" height=""350""/>", Расширение, Строка64));
		КонецЕсли;
		
		ФайлHTML = ФайлHTML + ЗаполняемыйШаблонHTML;

	КонецЦикла;
	
	ФайлHTML  = СтрЗаменить(ФайлHTML, " 0:00:00", "");
	ФайлHTML  = "<!DOCTYPE html>
				|<head>
				|<meta http-equiv=""Content-Type"" content=""text/html; charset=utf-8"">
				|<title>Список фильмов</title>
				|</head>
				|<body>" + ФайлHTML + "
				|</body>
				|</html>";
	
	Возврат ПоместитьВоВременноеХранилище(ФайлHTML, ЭтотОбъект.УникальныйИдентификатор);
	
КонецФункции

&НаКлиенте
Процедура ПослеЗавершенияЗаписиСтроки(ДопПараметры) Экспорт
	
	Перем ЗаписьВПамяти;
	
	Если ДопПараметры.Свойство("ЗаписьВПамяти", ЗаписьВПамяти) Тогда
		ЗаписьВПамяти.НачатьЗакрытие(Новый ОписаниеОповещения("ПослеЗавершенияОперацииЗакрытия", ЭтотОбъект, ДопПараметры));
	КонецЕсли;
	
КонецПроцедуры	

&НаКлиенте
Процедура ПослеЗавершенияОперацииЗакрытия(ДопПараметры) Экспорт
	
	Перем мПотокВПамяти;
	
	Если ДопПараметры.Свойство("мПотокВПамяти", мПотокВПамяти) Тогда
		БинарныеДанные = мПотокВПамяти.ЗакрытьИПолучитьДвоичныеДанные();
		Описание = Новый ОписаниеОповещения( , , ДопПараметры.ИмяФайла, "ПриВозникновенииОшибкиЗаписиФайла", ЭтотОбъект);
		БинарныеДанные.НачатьЗапись(Описание, ДопПараметры.ПолноеИмя);
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьРейтингIMDbНаСервере(ШапкаДокумента, СоответствиеФайлов)

	ШаблонДокумента =
		"<!DOCTYPE html>
		|<head>
		|<meta http-equiv=""Content-Type"" content=""text/html; charset=utf-8"">
		|<style>
		| table {border-collapse: collapse;}
		| table, th, td {border: 1px solid black;}
		|</style>
		|<title>%PageTitle%</title>
		|</head>
		|<body>";
	ТелоДокумента = "
		|<h1>%PageTitle% %Picture%</h1>
		|<table>
		|<tr>
		|<td>Номер<br>П/П</td>
		|<td>Фильм</td>
		|<td>IMDb</td>
		|<td>Дата выхода</td>
		|<!-- Скачан -->
		|<td>Жанры</td>
		|<td>Страны</td>
		|</tr>
		|";
	
	НеСформировано    = Истина;
	ШаблонДокумента   = СтрЗаменить(ШаблонДокумента, "%PageTitle%", НСтр("ru = 'Рейтинг IMDb'"));
	ВыводимыеСтраницы = Новый Соответствие;
	ВыводимыеСтраницы.Вставить(НСтр("ru = 'Рейтинг IMDb (Скачанные)'"), Истина);
	ВыводимыеСтраницы.Вставить(НСтр("ru = 'Рейтинг IMDb (Не скачанные)'"), Ложь);
	
	Для каждого КлючИЗначение Из ВыводимыеСтраницы Цикл
		
		Если КлючИЗначение.Значение Тогда
			ТекТелоДокумента = СтрЗаменить(ТелоДокумента, "<!-- Скачан -->", "<td>Скачан</td>");
		Иначе
			ТекТелоДокумента = ТелоДокумента;
		КонецЕсли;
		
		ТаблицаIMDb = Отчеты.РейтингIMDb.ПолучитьТаблицуФильмовПоIMDb(КлючИЗначение.Значение);
		Если ТаблицаIMDb.Количество() = 0 Тогда
			Продолжить;
		Иначе
			Если НеСформировано Тогда
				НеСформировано = Ложь;
			КонецЕсли;
		КонецЕсли;
		
		ШаблонДокумента = ШаблонДокумента + ТекТелоДокумента;
		ШаблонДокумента = СтрЗаменить(ШаблонДокумента, "%PageTitle%", КлючИЗначение.Ключ);
		ШаблонДокумента = СтрЗаменить(ШаблонДокумента, "%Picture%",   Символы.ПС + ПолучитьКодHTMLИзображения(БиблиотекаКартинок.Оскар48));
		
		Для каждого СтрокаТаблицы Из ТаблицаIMDb Цикл
			
			ТекСтрока = "<tr>
						|<td>" + (ТаблицаIMDb.Индекс(СтрокаТаблицы) + 1) + ".</td>
						|<td><!-- Наименование --></td>
						|<td>" + СтрокаТаблицы.IMDb + "</td>
						|<td>" + Формат(СтрокаТаблицы.ДатаВыхода, "ДФ=dd.MM.yyyy") + "</td>
						|<!-- Скачан -->
						|<td>" + СтрокаТаблицы.Жанр + "</td>
						|<td>" + СтрокаТаблицы.Страна + "</td>
						|</tr>
						|";
			
			Если КлючИЗначение.Значение Тогда
				ИмяФайлаHTML = ТранслироватьСтроку(СтрокаТаблицы.Наименование, СтрокаТаблицы.ДатаВыхода) + ".html";
				ТекСтрока    = СтрЗаменить(ТекСтрока, "<!-- Скачан -->", "<td>" + Формат(СтрокаТаблицы.ДатаСкачивания, "ДФ=dd.MM.yyyy") + "</td>");
				ТекСтрока    = СтрЗаменить(ТекСтрока, "<!-- Наименование -->", ПолучитьHTMLСсылку(ИмяФайлаHTML, СтрокаТаблицы.НаименованиеФильма));
			Иначе
				ТекСтрока = СтрЗаменить(ТекСтрока, "<!-- Наименование -->", СтрокаТаблицы.НаименованиеФильма);
			КонецЕсли;

			ШаблонДокумента = ШаблонДокумента + ТекСтрока;
			
		КонецЦикла;
		
		ШаблонДокумента = ШаблонДокумента + "</table>";
		
	КонецЦикла;
	
	Если НеСформировано Тогда
		Возврат;
	КонецЕсли;
	
	ШаблонДокумента = ШаблонДокумента + "
		|<p><a href=""index.html"">%Picture% На главную</a></p>
		|</body>
		|</html>";
	
	ШаблонДокумента = СтрЗаменить(ШаблонДокумента, "%Picture%", ПолучитьКодHTMLИзображения(БиблиотекаКартинок.СтандартнаяНастройкаКомпоновкиДанных));
	ШапкаДокумента  = СтрЗаменить(ШапкаДокумента, "<!-- Рейтинг IMDb -->", ПолучитьHTMLСсылку("rating_imdb.html", ПолучитьКодHTMLИзображения(БиблиотекаКартинок.СортироватьСписокПоВозрастанию) + НСтр("ru = 'Рейтинг IMDb'")));
	
	СоответствиеФайлов.Вставить("rating_imdb.html", ШаблонДокумента);
	
КонецПроцедуры

&НаКлиенте
Процедура ВывестиВHTMLвАвтоматическомРежиме()
	
	ВыбранныеФайлы = Новый Массив;
	ВыбранныеФайлы.Добавить(Параметры.ПутьВыгрузки);
	ПослеВыбораКаталогаВыводаВHTML(ВыбранныеФайлы, Неопределено);
	
	ПодключитьОбработчикОжидания("ЗавершитьРаботуСистемыЧерезОбработчикОжидания", 0.1, Истина);
		
КонецПроцедуры

&НаКлиенте
Процедура ЗавершитьРаботуСистемыЧерезОбработчикОжидания() Экспорт
	
	Если НЕ ПустаяСтрока(ПараметрЗапуска) Тогда
		ЗавершитьРаботуСистемы(Ложь, Ложь);
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСтатистикуПоФильмамЗаТриГодаНаСервере()

	СхемаКомпоновкиДанных = Новый СхемаКомпоновкиДанных;

	// 1. Добавляем Источник данных
	ИсточникДанных = СхемаКомпоновкиДанных.ИсточникиДанных.Добавить();
	ИсточникДанных.Имя = "ИсточникДанных1";
	ИсточникДанных.ТипИсточникаДанных = "Local";

	НаборДанныхЗапрос = СхемаКомпоновкиДанных.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
	НаборДанныхЗапрос.Имя = "НаборДанных1";
	НаборДанныхЗапрос.ИсточникДанных = "ИсточникДанных1";
	НаборДанныхЗапрос.Запрос =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ДатыСкачиванияФильмов.Фильм) КАК КоличествоФильмов,
		|	НАЧАЛОПЕРИОДА(ДатыСкачиванияФильмов.ДатаСкачивания, МЕСЯЦ) КАК Месяц,
		|	ГОД(ДатыСкачиванияФильмов.ДатаСкачивания) КАК Год
		|ПОМЕСТИТЬ ВременнаяТаблица
		|ИЗ
		|	РегистрСведений.ДатыСкачиванияФильмов КАК ДатыСкачиванияФильмов
		|ГДЕ
		|	ДатыСкачиванияФильмов.ДатаСкачивания МЕЖДУ ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(&ТекущаяДата, ГОД), ГОД, -2) И КОНЕЦПЕРИОДА(&ТекущаяДата, МЕСЯЦ)
		|	И ДатыСкачиванияФильмов.Фильм.ЕстьВФильмотеке
		|
		|СГРУППИРОВАТЬ ПО
		|	НАЧАЛОПЕРИОДА(ДатыСкачиванияФильмов.ДатаСкачивания, МЕСЯЦ),
		|	ГОД(ДатыСкачиванияФильмов.ДатаСкачивания)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВременнаяТаблица.КоличествоФильмов КАК КоличествоФильмов,
		|	ВЫБОР
		|		КОГДА ГОД(ВременнаяТаблица.Месяц) = ГОД(ДОБАВИТЬКДАТЕ(&ТекущаяДата, ГОД, -1))
		|			ТОГДА ДОБАВИТЬКДАТЕ(ВременнаяТаблица.Месяц, ГОД, 1)
		|		КОГДА ГОД(ВременнаяТаблица.Месяц) = ГОД(ДОБАВИТЬКДАТЕ(&ТекущаяДата, ГОД, -2))
		|			ТОГДА ДОБАВИТЬКДАТЕ(ВременнаяТаблица.Месяц, ГОД, 2)
		|		ИНАЧЕ ВременнаяТаблица.Месяц
		|	КОНЕЦ КАК Месяц,
		|	ВременнаяТаблица.Год КАК Год
		|{ВЫБРАТЬ
		|	КоличествоФильмов КАК КоличествоФильмов,
		|	Месяц КАК Месяц,
		|	Год КАК Год}
		|ИЗ
		|	ВременнаяТаблица КАК ВременнаяТаблица";

	// 2. Добавляем поля набора данных
	ПолеНабораКД = СхемаКомпоновкиДанных.НаборыДанных.НаборДанных1.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
	ПолеНабораКД.Заголовок      = НСтр("ru = 'Год'");
	ПолеНабораКД.ПутьКДанным    = "Год";
	ПолеНабораКД.Поле           = "Год";
	ПолеНабораКД.ТипЗначения    = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(4, 0, ДопустимыйЗнак.Неотрицательный));
