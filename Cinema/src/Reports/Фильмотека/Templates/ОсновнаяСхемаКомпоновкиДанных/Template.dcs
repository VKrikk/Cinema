<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>НаборДанныхФильмы</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Фильм</dataPath>
			<field>Фильм</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Фильм</v8:content>
				</v8:item>
			</title>
			<presentationExpression>Наименование</presentationExpression>
			<valueType>
				<v8:Type xmlns:d5p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d5p1:CatalogRef.Фильмы</v8:Type>
			</valueType>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Наименование</dataPath>
			<field>Наименование</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Наименование</v8:content>
				</v8:item>
			</title>
			<valueType>
				<v8:Type>xs:string</v8:Type>
				<v8:StringQualifiers>
					<v8:Length>150</v8:Length>
					<v8:AllowedLength>Variable</v8:AllowedLength>
				</v8:StringQualifiers>
			</valueType>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаВыхода</dataPath>
			<field>ДатаВыхода</field>
			<valueType>
				<v8:Type>xs:dateTime</v8:Type>
				<v8:DateQualifiers>
					<v8:DateFractions>Date</v8:DateFractions>
				</v8:DateQualifiers>
			</valueType>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЦифровойРелиз</dataPath>
			<field>ЦифровойРелиз</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаСкачивания</dataPath>
			<field>ДатаСкачивания</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Дата скачивания</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЕстьВФильмотеке</dataPath>
			<field>ЕстьВФильмотеке</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Формат3D</dataPath>
			<field>Формат3D</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаСортировки</dataPath>
			<field>ДатаСортировки</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Дата сортировки</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	Фильмы.Ссылка КАК Фильм,
	Фильмы.Наименование + ВЫБОР
		КОГДА Фильмы.ОригинальноеНазвание = ""
			ТОГДА ""
		ИНАЧЕ " (" + Фильмы.ОригинальноеНазвание + ")"
	КОНЕЦ + ВЫБОР
		КОГДА Фильмы.Формат3D
			ТОГДА " 3D"
		ИНАЧЕ ""
	КОНЕЦ КАК Наименование,
	Фильмы.ДатаВыхода КАК ДатаВыхода,
	Фильмы.ЦифровойРелиз КАК ЦифровойРелиз,
	ЕСТЬNULL(ДатыСкачиванияФильмов.ДатаСкачивания, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаСкачивания,
	ЕСТЬNULL(ДатыСкачиванияФильмов.ДатаСкачивания, Фильмы.ДатаВыхода) КАК ДатаСортировки
{ВЫБРАТЬ
	Фильм.* КАК Фильм,
	Наименование КАК Наименование,
	ДатаВыхода КАК ДатаВыхода,
	ЦифровойРелиз КАК ЦифровойРелиз,
	ДатаСкачивания КАК ДатаСкачивания,
	ДатаСортировки КАК ДатаСортировки}
ИЗ
	Справочник.Фильмы КАК Фильмы
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ДатыСкачиванияФильмов КАК ДатыСкачиванияФильмов
		ПО Фильмы.Ссылка = ДатыСкачиванияФильмов.Фильм
ГДЕ
	НЕ Фильмы.ПометкаУдаления
	И НЕ Фильмы.ЭтоГруппа
{ГДЕ
	Фильмы.Ссылка.* КАК Фильм,
	Фильмы.ДатаВыхода КАК ДатаВыхода,
	Фильмы.ЕстьВФильмотеке КАК ЕстьВФильмотеке,
	Фильмы.Формат3D КАК Формат3D}
{ХАРАКТЕРИСТИКИ
	ТИП(Справочник.Фильмы)
	ВИДЫХАРАКТЕРИСТИК ПланВидовХарактеристик.ДополнительныеСвойства
	ПОЛЕКЛЮЧА Ссылка
	ПОЛЕИМЕНИ Наименование
	ПОЛЕТИПАЗНАЧЕНИЯ ТипЗначения
	ЗНАЧЕНИЯХАРАКТЕРИСТИК РегистрСведений.ЗначенияДополнительныхСвойств
	ПОЛЕОБЪЕКТА Фильм
	ПОЛЕВИДА Свойство
	ПОЛЕЗНАЧЕНИЯ ЗначениеСвойства }</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
	<dataSet xsi:type="DataSetQuery">
		<name>НаборДанныхЖанры</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Жанр</dataPath>
			<field>Жанр</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
			<valueType>
				<v8:Type xmlns:d5p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d5p1:CatalogRef.Жанры</v8:Type>
			</valueType>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Фильм</dataPath>
			<field>Фильм</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
			<valueType>
				<v8:Type xmlns:d5p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d5p1:CatalogRef.Фильмы</v8:Type>
			</valueType>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЖанрыФильмов.Фильм КАК Фильм,
	ЖанрыФильмов.Жанр КАК Жанр
{ВЫБРАТЬ
	Фильм.* КАК Фильм,
	Жанр.* КАК Жанр}
ИЗ
	РегистрСведений.ЖанрыФильмов КАК ЖанрыФильмов
{ГДЕ
	ЖанрыФильмов.Фильм.* КАК Фильм,
	ЖанрыФильмов.Жанр.* КАК Жанр}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
	<dataSet xsi:type="DataSetQuery">
		<name>НаборДанныхСтраны</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Фильм</dataPath>
			<field>Фильм</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
			<valueType>
				<v8:Type xmlns:d5p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d5p1:CatalogRef.Фильмы</v8:Type>
			</valueType>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Страна</dataPath>
			<field>Страна</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
			<valueType>
				<v8:Type xmlns:d5p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d5p1:CatalogRef.Страны</v8:Type>
			</valueType>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	СтраныПроизводители.Фильм КАК Фильм,
	СтраныПроизводители.Страна КАК Страна
{ВЫБРАТЬ
	Фильм.* КАК Фильм,
	Страна.* КАК Страна}
ИЗ
	РегистрСведений.СтраныПроизводители КАК СтраныПроизводители
{ГДЕ
	СтраныПроизводители.Фильм.* КАК Фильм,
	СтраныПроизводители.Страна.* КАК Страна}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
	<dataSet xsi:type="DataSetQuery">
		<name>НаборДанныхАннотации</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Фильм</dataPath>
			<field>Фильм</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Фильм</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Аннотация</dataPath>
			<field>Аннотация</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Аннотация</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Формат3D</dataPath>
			<field>Формат3D</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Формат3 D</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаВыхода</dataPath>
			<field>ДатаВыхода</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Дата выхода</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЕстьВФильмотеке</dataPath>
			<field>ЕстьВФильмотеке</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Есть в фильмотеке</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	Аннотации.Владелец КАК Фильм,
	Аннотации.СодержаниеАннотации КАК Аннотация
{ВЫБРАТЬ
	Фильм.* КАК Фильм,
	Аннотация КАК Аннотация}
ИЗ
	Справочник.Аннотации КАК Аннотации
ГДЕ
	НЕ Аннотации.Владелец.ПометкаУдаления
	И НЕ Аннотации.Владелец.ЭтоГруппа
{ГДЕ
	Аннотации.Владелец.* КАК Фильм,
	Аннотации.Владелец.ДатаВыхода КАК ДатаВыхода,
	Аннотации.Владелец.ЕстьВФильмотеке КАК ЕстьВФильмотеке,
	Аннотации.Владелец.Формат3D КАК Формат3D}</query>
		<autoFillFields>false</autoFillFields>
	</dataSet>
	<dataSetLink>
		<sourceDataSet>НаборДанныхФильмы</sourceDataSet>
		<destinationDataSet>НаборДанныхЖанры</destinationDataSet>
		<sourceExpression>Фильм</sourceExpression>
		<destinationExpression>Фильм</destinationExpression>
	</dataSetLink>
	<dataSetLink>
		<sourceDataSet>НаборДанныхФильмы</sourceDataSet>
		<destinationDataSet>НаборДанныхСтраны</destinationDataSet>
		<sourceExpression>Фильм</sourceExpression>
		<destinationExpression>Фильм</destinationExpression>
	</dataSetLink>
	<dataSetLink>
		<sourceDataSet>НаборДанныхФильмы</sourceDataSet>
		<destinationDataSet>НаборДанныхАннотации</destinationDataSet>
		<sourceExpression>Фильм</sourceExpression>
		<destinationExpression>Фильм</destinationExpression>
	</dataSetLink>
	<totalField>
		<dataPath>Жанр</dataPath>
		<expression>СоединитьСтроки(Массив(Различные Жанр), ", ")</expression>
		<group>Фильм</group>
	</totalField>
	<totalField>
		<dataPath>Страна</dataPath>
		<expression>СоединитьСтроки(Массив(Различные Страна), ",")</expression>
		<group>Фильм</group>
	</totalField>
	<totalField>
		<dataPath>Аннотация</dataPath>
		<expression>СоединитьСтроки(Массив(Различные Аннотация), ", ")</expression>
		<group>Фильм</group>
	</totalField>
	<settingsVariant>
		<dcsset:name>Фильмотека</dcsset:name>
		<dcsset:presentation xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Фильмотека</v8:content>
			</v8:item>
		</dcsset:presentation>
		<dcsset:settings xmlns:style="http://v8.1c.ru/8.1/data/ui/style" xmlns:sys="http://v8.1c.ru/8.1/data/ui/fonts/system" xmlns:web="http://v8.1c.ru/8.1/data/ui/colors/web" xmlns:win="http://v8.1c.ru/8.1/data/ui/colors/windows">
			<dcsset:selection>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>СистемныеПоля.НомерПоПорядку</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>Фильм</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>ДатаВыхода</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>ЦифровойРелиз</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>ДатаСкачивания</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>Жанр</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>Страна</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>Аннотация</dcsset:field>
				</dcsset:item>
			</dcsset:selection>
			<dcsset:filter>
				<dcsset:item xsi:type="dcsset:FilterItemComparison">
					<dcsset:use>false</dcsset:use>
					<dcsset:left xsi:type="dcscor:Field">Фильм</dcsset:left>
					<dcsset:comparisonType>Equal</dcsset:comparisonType>
					<dcsset:right xsi:type="dcscor:DesignTimeValue">Справочник.Фильмы.ПустаяСсылка</dcsset:right>
					<dcsset:userSettingID>bb010fe2-7e81-43c5-a621-237ccba1dcda</dcsset:userSettingID>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:FilterItemComparison">
					<dcsset:use>false</dcsset:use>
					<dcsset:left xsi:type="dcscor:Field">Жанр</dcsset:left>
					<dcsset:comparisonType>Equal</dcsset:comparisonType>
					<dcsset:right xsi:type="dcscor:DesignTimeValue">Справочник.Жанры.ПустаяСсылка</dcsset:right>
					<dcsset:userSettingID>cf6fb6bb-75e3-4768-a975-0231dd494b17</dcsset:userSettingID>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:FilterItemComparison">
					<dcsset:use>false</dcsset:use>
					<dcsset:left xsi:type="dcscor:Field">Страна</dcsset:left>
					<dcsset:comparisonType>Equal</dcsset:comparisonType>
					<dcsset:right xsi:type="dcscor:DesignTimeValue">Справочник.Страны.ПустаяСсылка</dcsset:right>
					<dcsset:userSettingID>2e89d2ba-f4a4-4ae5-b4eb-0c5110f634ee</dcsset:userSettingID>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:FilterItemComparison">
					<dcsset:left xsi:type="dcscor:Field">ЕстьВФильмотеке</dcsset:left>
					<dcsset:comparisonType>Equal</dcsset:comparisonType>
					<dcsset:right xsi:type="xs:boolean">true</dcsset:right>
					<dcsset:userSettingID>ef5ec1d9-8ce6-4458-862a-d7342ca313d1</dcsset:userSettingID>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:FilterItemComparison">
					<dcsset:use>false</dcsset:use>
					<dcsset:left xsi:type="dcscor:Field">Формат3D</dcsset:left>
					<dcsset:comparisonType>Equal</dcsset:comparisonType>
					<dcsset:right xsi:type="xs:boolean">false</dcsset:right>
					<dcsset:userSettingID>49fbf523-ec81-4402-8bcd-ae6424ca6f9e</dcsset:userSettingID>
				</dcsset:item>
				<dcsset:userSettingID>ec2729a6-bd36-41a7-9e82-16667b09e150</dcsset:userSettingID>
			</dcsset:filter>
			<dcsset:order>
				<dcsset:item xsi:type="dcsset:OrderItemField">
					<dcsset:field>ДатаСортировки</dcsset:field>
					<dcsset:orderType>Desc</dcsset:orderType>
				</dcsset:item>
			</dcsset:order>
			<dcsset:conditionalAppearance>
				<dcsset:item>
					<dcsset:selection>
						<dcsset:item>
							<dcsset:field>ДатаВыхода</dcsset:field>
						</dcsset:item>
						<dcsset:item>
							<dcsset:field>ДатаСкачивания</dcsset:field>
						</dcsset:item>
						<dcsset:item>
							<dcsset:field>ЦифровойРелиз</dcsset:field>
						</dcsset:item>
						<dcsset:item>
							<dcsset:field>Жанр</dcsset:field>
						</dcsset:item>
						<dcsset:item>
							<dcsset:field>Страна</dcsset:field>
						</dcsset:item>
					</dcsset:selection>
					<dcsset:filter/>
					<dcsset:appearance>
						<dcscor:item xsi:type="dcsset:SettingsParameterValue">
							<dcscor:parameter>МинимальнаяШирина</dcscor:parameter>
							<dcscor:value xsi:type="xs:decimal">12</dcscor:value>
						</dcscor:item>
						<dcscor:item xsi:type="dcsset:SettingsParameterValue">
							<dcscor:parameter>МаксимальнаяШирина</dcscor:parameter>
							<dcscor:value xsi:type="xs:decimal">12</dcscor:value>
						</dcscor:item>
					</dcsset:appearance>
				</dcsset:item>
				<dcsset:item>
					<dcsset:selection>
						<dcsset:item>
							<dcsset:field>Фильм</dcsset:field>
						</dcsset:item>
					</dcsset:selection>
					<dcsset:filter/>
					<dcsset:appearance>
						<dcscor:item xsi:type="dcsset:SettingsParameterValue">
							<dcscor:parameter>МинимальнаяШирина</dcscor:parameter>
							<dcscor:value xsi:type="xs:decimal">30</dcscor:value>
						</dcscor:item>
						<dcscor:item xsi:type="dcsset:SettingsParameterValue">
