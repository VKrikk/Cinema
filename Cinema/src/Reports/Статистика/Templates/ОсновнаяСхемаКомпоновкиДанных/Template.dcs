		<settings xmlns:style="http://v8.1c.ru/8.1/data/ui/style" xmlns:sys="http://v8.1c.ru/8.1/data/ui/fonts/system" xmlns:web="http://v8.1c.ru/8.1/data/ui/colors/web" xmlns:win="http://v8.1c.ru/8.1/data/ui/colors/windows"/>
	</nestedSchema>
	<nestedSchema>
		<name>КоличествоПоЖанрам</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Количество по жанрам</v8:content>
			</v8:item>
		</title>
		<schema>
			<dataSource>
				<name>ИсточникДанных1</name>
				<dataSourceType>Local</dataSourceType>
			</dataSource>
			<dataSet xsi:type="DataSetQuery">
				<name>НаборДанных1</name>
				<field xsi:type="DataSetFieldField">
					<dataPath>КоличествоФильмов</dataPath>
					<field>КоличествоФильмов</field>
					<title xsi:type="v8:LocalStringType">
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Количество фильмов</v8:content>
						</v8:item>
					</title>
					<valueType>
						<v8:Type>xs:decimal</v8:Type>
						<v8:NumberQualifiers>
							<v8:Digits>15</v8:Digits>
							<v8:FractionDigits>0</v8:FractionDigits>
							<v8:AllowedSign>Any</v8:AllowedSign>
						</v8:NumberQualifiers>
					</valueType>
				</field>
				<field xsi:type="DataSetFieldField">
					<dataPath>Жанр</dataPath>
					<field>Жанр</field>
					<role>
						<dcscom:dimension>true</dcscom:dimension>
					</role>
					<presentationExpression>Выбор Когда Жанр = ЗНАЧЕНИЕ(Справочник.Жанры.ПустаяСсылка) Тогда "3D" Иначе Строка(Жанр) Конец</presentationExpression>
					<valueType>
						<v8:Type xmlns:d7p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d7p1:CatalogRef.Жанры</v8:Type>
					</valueType>
				</field>
				<dataSource>ИсточникДанных1</dataSource>
				<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ЖанрыФильмов.Жанр КАК Жанр,
	СУММА(1) КАК КоличествоФильмов
{ВЫБРАТЬ
	Жанр.* КАК Жанр,
	КоличествоФильмов КАК КоличествоФильмов}
ИЗ
	РегистрСведений.ЖанрыФильмов КАК ЖанрыФильмов
ГДЕ
	ЖанрыФильмов.Фильм.ЕстьВФильмотеке = ИСТИНА

СГРУППИРОВАТЬ ПО
	ЖанрыФильмов.Жанр

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	ЗНАЧЕНИЕ(Справочник.Жанры.ПустаяСсылка),
	СУММА(1)
ИЗ
	Справочник.Фильмы КАК Фильмы
ГДЕ
	Фильмы.Формат3D = ИСТИНА
	И Фильмы.ЕстьВФильмотеке = ИСТИНА
	И Фильмы.ИмяФайла ПОДОБНО "%[\/]3D[\/]%"</query>
				<autoFillFields>false</autoFillFields>
			</dataSet>
			<totalField>
				<dataPath>КоличествоФильмов</dataPath>
				<expression>Сумма(КоличествоФильмов)</expression>
			</totalField>
			<settingsVariant>
				<dcsset:name>Количество по жанрам</dcsset:name>
				<dcsset:presentation xsi:type="v8:LocalStringType">
					<v8:item>
