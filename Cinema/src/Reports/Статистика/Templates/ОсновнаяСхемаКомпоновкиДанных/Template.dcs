	<nestedSchema>
		<name>РазмерыФильмовПоЖанрам</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Размеры фильмов по жанрам</v8:content>
			</v8:item>
		</title>
		<schema>
			<dataSource>
				<name>ИсточникДанных1</name>
				<dataSourceType>Local</dataSourceType>
			</dataSource>
			<dataSet xsi:type="DataSetQuery">
				<name>НаборДанных1</name>
				<field xsi:type="DataSetFieldField">
					<dataPath>Жанр</dataPath>
					<field>Жанр</field>
					<title xsi:type="v8:LocalStringType">
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Жанр</v8:content>
						</v8:item>
					</title>
					<role>
						<dcscom:dimension>true</dcscom:dimension>
					</role>
					<presentationExpression>Выбор Когда Жанр = ЗНАЧЕНИЕ(Справочник.Жанры.ПустаяСсылка) Тогда "3D" Иначе Строка(Жанр) Конец</presentationExpression>
					<valueType>
						<v8:Type xmlns:d7p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d7p1:CatalogRef.Жанры</v8:Type>
					</valueType>
				</field>
				<field xsi:type="DataSetFieldField">
					<dataPath>РазмерФайла</dataPath>
					<field>РазмерФайла</field>
					<title xsi:type="v8:LocalStringType">
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>Размер файла</v8:content>
						</v8:item>
					</title>
					<valueType>
						<v8:Type>xs:decimal</v8:Type>
						<v8:NumberQualifiers>
							<v8:Digits>15</v8:Digits>
							<v8:FractionDigits>0</v8:FractionDigits>
							<v8:AllowedSign>Any</v8:AllowedSign>
						</v8:NumberQualifiers>
					</valueType>
				</field>
				<dataSource>ИсточникДанных1</dataSource>
				<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	РазмерыФайлов.Жанр КАК Жанр,
	СУММА(ВЫРАЗИТЬ(РазмерыФайлов.РазмерФайла / 1073741824 КАК ЧИСЛО(15, 3))) КАК РазмерФайла
{ВЫБРАТЬ
	Жанр.* КАК Жанр,
	РазмерФайла КАК РазмерФайла}
ИЗ
	(ВЫБРАТЬ
		ЗНАЧЕНИЕ(Справочник.Жанры.ПустаяСсылка) КАК Жанр,
		Фильмы.РазмерФайла КАК РазмерФайла
	ИЗ
		Справочник.Фильмы КАК Фильмы
	ГДЕ
		Фильмы.ЕстьВФильмотеке = ИСТИНА
		И Фильмы.Формат3D = ИСТИНА
		И Фильмы.ИмяФайла ПОДОБНО "%[\/]3D[\/]%"
	
	ОБЪЕДИНИТЬ ВСЕ
	
	ВЫБРАТЬ
		Жанры.Жанр,
		СУММА(Жанры.Фильм.РазмерФайла)
	ИЗ
		(ВЫБРАТЬ
			МАКСИМУМ(ЖанрыФильмов.Жанр) КАК Жанр,
			ЖанрыФильмов.Фильм КАК Фильм
		ИЗ
			РегистрСведений.ЖанрыФильмов КАК ЖанрыФильмов
		ГДЕ
			ЖанрыФильмов.Фильм.ЕстьВФильмотеке = ИСТИНА
			И НЕ ЖанрыФильмов.Фильм В
						(ВЫБРАТЬ
							Фильмы.Ссылка КАК Ссылка
						ИЗ
							Справочник.Фильмы КАК Фильмы
						ГДЕ
							Фильмы.ЕстьВФильмотеке = ИСТИНА
							И Фильмы.Формат3D = ИСТИНА
							И Фильмы.ИмяФайла ПОДОБНО "%[\/]3D[\/]%")
		
		СГРУППИРОВАТЬ ПО
			ЖанрыФильмов.Фильм) КАК Жанры
	
	СГРУППИРОВАТЬ ПО
		Жанры.Жанр) КАК РазмерыФайлов

СГРУППИРОВАТЬ ПО
	РазмерыФайлов.Жанр</query>
				<autoFillFields>false</autoFillFields>
			</dataSet>
			<totalField>
				<dataPath>РазмерФайла</dataPath>
				<expression>Сумма(РазмерФайла)</expression>
			</totalField>
