								<v8:item>
									<v8:lang>ru</v8:lang>
									<v8:content>Количество по жанрам</v8:content>
								</v8:item>
							</dcscor:value>
						</dcscor:item>
					</dcsset:outputParameters>
					<dcsset:item xsi:type="dcsset:StructureItemChart">
