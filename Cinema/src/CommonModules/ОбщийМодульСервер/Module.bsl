
Процедура ПроверкаПовторяющихсяНаименованийПередЗаписью(Источник, Отказ) Экспорт

	Если Источник.ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ Источник.ЭтоНовый() Тогда
		Возврат;
	КонецЕсли;
	
	ОписанияМетаданных = Источник.Метаданные();
	
	Если ОписанияМетаданных.ДлинаНаименования = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если Источник.ЭтоГруппа Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый ("Запрос");
	
	ТекстЗапроса =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Ссылка
		|ИЗ
		|	Справочник." + ОписанияМетаданных.Имя + "
		|ГДЕ
		|	Наименование = &Наименование
		|	И НЕ ПометкаУдаления";
		
	Запрос.УстановитьПараметр("Наименование", Источник.Наименование);
	
	Если ОписанияМетаданных.Иерархический Тогда
		Запрос.УстановитьПараметр("Родитель", Источник.Родитель);
		ТекстЗапроса = ТекстЗапроса +
			" И Родитель = &Родитель";
	КонецЕсли;
		
	Запрос.Текст = ТекстЗапроса;	
	
	Результат = Запрос.Выполнить();
	
	Отказ = НЕ Результат.Пустой();	

	Если Отказ Тогда
		
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Элемент с таким наименованием уже записан в ИБ!";
		Сообщение.Поле = "Наименование";
		Сообщение.УстановитьДанные(Источник);
		Сообщение.Сообщить();
		
	КонецЕсли;
	
КонецПроцедуры

Процедура СинхронизироватьТаблицуФильмов(ТаблицаИменФайлов) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Т.Фильм КАК Фильм,
		|	Т.ИмяФайла КАК ИмяФайла,
		|	Т.ПолноеИмя КАК ПолноеИмя,
		|	Т.Размер КАК Размер,
		|	Т.Найден КАК Найден
		|ПОМЕСТИТЬ ВрФильмы
		|ИЗ
		|	&ТаблицаИменФайлов КАК Т
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ВрФильмы.Фильм КАК Фильм,
		|	ВрФильмы.Фильм.РазмерФайла КАК РазмерФайла,
		|	ВрФильмы.Размер КАК Размер
		|ИЗ
		|	ВрФильмы КАК ВрФильмы
		|ГДЕ
		|	ВрФильмы.Найден = ИСТИНА
		|	И (ВрФильмы.Фильм.РазмерФайла <> ВрФильмы.Размер
		|		ИЛИ ВрФильмы.Фильм.ЕстьВФильмотеке = ЛОЖЬ)
		|УПОРЯДОЧИТЬ ПО
		|	Фильм.Наименование";
	Запрос.УстановитьПараметр("ТаблицаИменФайлов", ТаблицаИменФайлов);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл

		СпрОбъект = Выборка.Фильм.ПолучитьОбъект();
		СпрОбъект.ОбменДанными.Загрузка = Истина;
		
		Если СпрОбъект.РазмерФайла <> Выборка.Размер Тогда
		    СпрОбъект.РазмерФайла = Выборка.Размер;
		КонецЕсли; 
		
		Если НЕ СпрОбъект.ЕстьВФильмотеке Тогда
		    СпрОбъект.ЕстьВФильмотеке = Истина;
		КонецЕсли; 
		
		Если СпрОбъект.Модифицированность() Тогда
			Попытка
			    СпрОбъект.Записать();
			Исключение
				ЗаписьЖурналаРегистрации(НСтр("ru = 'Обновление реквизитов фильма'"), УровеньЖурналаРегистрации.Ошибка, , Выборка.Фильм, ОписаниеОшибки());
			КонецПопытки;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

Процедура СохранитьНастройкуВХранилище(КлючОбъекта, КлючНастроек, Настройки, ОписаниеНастроек = Неопределено, ИмяПользователя = Неопределено) Экспорт
	
	ХранилищеОбщихНастроек.Сохранить(КлючОбъекта, КлючНастроек, Настройки);
	
КонецПроцедуры

Функция ЗагрузитьНастройкуИзХранилища(КлючОбъекта, КлючНастроек, ОписаниеНастроек = Неопределено, ИмяПользователя = Неопределено) Экспорт
	
	Настройка = ХранилищеОбщихНастроек.Загрузить(КлючОбъекта, КлючНастроек, ОписаниеНастроек, ИмяПользователя);
	
	Возврат Настройка;
	
КонецФункции

Процедура КонтрольКорректностиЗаполнения() Экспорт
	
	ТекстЗапроса = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 5
		|	Фильмы.Ссылка КАК Фильм,
		|	МинимальныйРазмерИзображения.Значение КАК МинимальныйРазмерИзображения
		|ИЗ
		|	Справочник.Фильмы КАК Фильмы
		|		ПОЛНОЕ СОЕДИНЕНИЕ Константа.МинимальныйРазмерИзображения КАК МинимальныйРазмерИзображения
		|		ПО (ИСТИНА)
		|ГДЕ
		|	НЕ Фильмы.ЗаполненКорректно
		|	И НЕ Фильмы.ЭтоГруппа
		|	И НЕ Фильмы.ПометкаУдаления
		|
		|УПОРЯДОЧИТЬ ПО
		|	Фильмы.ДатаВыхода,
		|	Фильмы.Наименование";
	
	Запрос = Новый Запрос;
	Схема  = Новый СхемаЗапроса;
	Схема.УстановитьТекстЗапроса(ТекстЗапроса);
	
	мТекущаяДата   = ТекущаяДатаСеанса();
	НачальноеЧисло = Час(мТекущаяДата) * 3600 + Минута(мТекущаяДата) * 60 + Секунда(мТекущаяДата);
	ГенСлЧисел     = Новый ГенераторСлучайныхЧисел(НачальноеЧисло);
	КолЗаписей     = ГенСлЧисел.СлучайноеЧисло(1, 30);
	Нечетное       = ?(Окр(КолЗаписей / 2) = КолЗаписей / 2, Ложь, Истина);
	Обновлять      = Ложь;
	
	Для каждого ТекПакетЗапросов Из Схема.ПакетЗапросов Цикл
		
		Для каждого ТекОператор Из ТекПакетЗапросов.Операторы Цикл
			ТекОператор.КоличествоПолучаемыхЗаписей = КолЗаписей;
		КонецЦикла;
		
		Для каждого ТекПорядок Из ТекПакетЗапросов.Порядок Цикл
			Если Нечетное Тогда
		    	ТекПорядок.Направление = НаправлениеПорядкаСхемыЗапроса.ПоВозрастанию;
			Иначе
		    	ТекПорядок.Направление = НаправлениеПорядкаСхемыЗапроса.ПоУбыванию;
			КонецЕсли;
			Нечетное = НЕ Нечетное;
		КонецЦикла;
	
	КонецЦикла;
	
	Запрос.Текст = Схема.ПолучитьТекстЗапроса();
	
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если ФильмКорректноЗаполнен(Запрос, Выборка.Фильм, Выборка.МинимальныйРазмерИзображения) Тогда
			СпрОбъект = Выборка.Фильм.ПолучитьОбъект();
			СпрОбъект.ОбменДанными.Загрузка = Истина;
			СпрОбъект.ЗаполненКорректно = Истина;
			Попытка
			    СпрОбъект.Записать();
				Обновлять = Истина;
			Исключение
			КонецПопытки;
		Иначе
		КонецЕсли;
		
	КонецЦикла;
	
	Если Обновлять Тогда
		ОбновитьИсториюДанных();
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьСтруктуруПараметровЭлПочты() Экспорт

	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("АдресСервераSMTP",	Константы.АдресСервераSMTP.Получить());
	СтруктураПараметров.Вставить("Пароль",				Константы.Пароль.Получить());
	СтруктураПараметров.Вставить("Пользователь",		Константы.Пользователь.Получить());
	СтруктураПараметров.Вставить("ПортSMTP",			Константы.ПортSMTP.Получить());
	СтруктураПараметров.Вставить("АдресОтправителя",	Константы.АдресОтправителя.Получить());
	
	Возврат СтруктураПараметров;

КонецФункции

