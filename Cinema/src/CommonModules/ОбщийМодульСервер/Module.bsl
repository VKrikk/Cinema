КонецПроцедуры

Функция ФильмКорректноЗаполнен(Запрос, Фильм, ОбъемомНеМеньше) Экспорт

	ЗначениеВХранилище = Фильм.Афиша.Получить();
	Если ТипЗнч(ЗначениеВХранилище) <> Тип("Картинка") Тогда
		Возврат Ложь;
	Иначе
		Если ЗначениеВХранилище.Вид = ВидКартинки.Пустая Тогда
			Возврат Ложь;
		КонецЕсли;
		ДвчДанные = ЗначениеВХранилище.ПолучитьДвоичныеДанные();
		Если ТипЗнч(ДвчДанные) = Тип("ДвоичныеДанные") Тогда
			РазмерДанных = ДвчДанные.Размер();
			Если ОбъемомНеМеньше > РазмерДанных Тогда
				Возврат Ложь;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Фильм", Фильм);
	Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Фильмы.Ссылка КАК Фильм
		|ПОМЕСТИТЬ Фильмы
		|ИЗ
		|	Справочник.Фильмы КАК Фильмы
		|ГДЕ
		|	Фильмы.Ссылка = &Фильм
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Аннотации.Владелец КАК Фильм,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ Аннотации.Ссылка) КАК Аннотация
		|ПОМЕСТИТЬ Аннотации
		|ИЗ
		|	Справочник.Аннотации КАК Аннотации
		|ГДЕ
		|	Аннотации.Владелец = &Фильм
		|	И НЕ Аннотации.ПометкаУдаления
		|
		|СГРУППИРОВАТЬ ПО
		|	Аннотации.Владелец
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ЖанрыФильмов.Фильм КАК Фильм,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ЖанрыФильмов.Жанр) КАК Жанр
		|ПОМЕСТИТЬ Жанры
		|ИЗ
		|	РегистрСведений.ЖанрыФильмов КАК ЖанрыФильмов
		|ГДЕ
		|	ЖанрыФильмов.Фильм = &Фильм
		|
		|СГРУППИРОВАТЬ ПО
		|	ЖанрыФильмов.Фильм
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	СтраныПроизводители.Фильм КАК Фильм,
		|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ СтраныПроизводители.Страна) КАК Страна
		|ПОМЕСТИТЬ Страны
		|ИЗ
		|	РегистрСведений.СтраныПроизводители КАК СтраныПроизводители
		|ГДЕ
		|	СтраныПроизводители.Фильм = &Фильм
		|
		|СГРУППИРОВАТЬ ПО
		|	СтраныПроизводители.Фильм
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Фильмы.Фильм КАК Фильм
		|ИЗ
		|	Фильмы КАК Фильмы
		|		ЛЕВОЕ СОЕДИНЕНИЕ Аннотации КАК Аннотации
		|		ПО Фильмы.Фильм = Аннотации.Фильм
		|		ЛЕВОЕ СОЕДИНЕНИЕ Жанры КАК Жанры
		|		ПО Фильмы.Фильм = Жанры.Фильм
		|		ЛЕВОЕ СОЕДИНЕНИЕ Страны КАК Страны
		|		ПО Фильмы.Фильм = Страны.Фильм
		|ГДЕ
		|	ВЫБОР
		|			КОГДА Аннотации.Аннотация ЕСТЬ NULL
		|				ТОГДА ИСТИНА
		|			КОГДА Жанры.Жанр ЕСТЬ NULL
		|				ТОГДА ИСТИНА
		|			КОГДА Страны.Страна ЕСТЬ NULL
		|				ТОГДА ИСТИНА
		|			ИНАЧЕ ЛОЖЬ
		|		КОНЕЦ";

	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

Процедура Пауза(Секунд) Экспорт
	
	ТекущийСеансИнформационнойБазы = ПолучитьТекущийСеансИнформационнойБазы();
	ФоновоеЗадание = ТекущийСеансИнформационнойБазы.ПолучитьФоновоеЗадание();
	
	Если ФоновоеЗадание = Неопределено Тогда
		Параметры = Новый Массив;
		Параметры.Добавить(Секунд);
		ФоновоеЗадание = ФоновыеЗадания.Выполнить("ОбщийМодульСервер.Пауза", Параметры);
	КонецЕсли;
		
	Попытка
		ФоновоеЗадание.ОжидатьЗавершения(Секунд);
	Исключение
		Возврат;
	КонецПопытки;
	
КонецПроцедуры

Процедура УменьшениеРазмеровИзображений() Экспорт
	
	Перем КодВозврата;
	
	УтилитаСжатияИзображений = Константы.УтилитаСжатияИзображений.Получить(); //"C:\Program Files\XnView\nconvert.exe";
	Если ПустаяСтрока(УтилитаСжатияИзображений) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыУтилитыСжатия = Константы.ПараметрыУтилитыСжатия.Получить(); //"-resize 90% 90% -overwrite -no_auto_ext";
	ФайлУтилитаСжатия      = Новый Файл(УтилитаСжатияИзображений);
	
	Если НЕ ФайлУтилитаСжатия.Существует() Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 10
		|	ЕСТЬNULL(Фильмы.Ссылка, ЗНАЧЕНИЕ(Справочник.Фильмы.ПустаяСсылка)) КАК Фильм,
		|	ЕСТЬNULL(Фильмы.РазмерИзображения, 0) КАК СтарыйРазмер
		|ИЗ
		|	Константы КАК Константы
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Фильмы КАК Фильмы
		|		ПО (Фильмы.РазмерИзображения > Константы.МаксимальныйРазмерИзображения)
		|
		|УПОРЯДОЧИТЬ ПО
		|	СтарыйРазмер УБЫВ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если НЕ ЗначениеЗаполнено(Выборка.Фильм) ИЛИ Выборка.СтарыйРазмер = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Афиша = Выборка.Фильм.Афиша.Получить();
		
		Если ТипЗнч(Афиша) <> Тип("Картинка") Тогда
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Уменьшение размеров изображений'"), УровеньЖурналаРегистрации.Ошибка, ,
										Выборка.Фильм, НСтр("ru = 'Реквизит ""Афиша"" не является типом ""Картинка"".'"));
			Продолжить;
		КонецЕсли;
		
		РасширениеФайла = "." + НРег(Строка(Афиша.Формат()));
		БинарныеДанные  = Афиша.ПолучитьДвоичныеДанные();
		ИмяВременного   = ПолучитьИмяВременногоФайла(РасширениеФайла);
		
		Попытка
			БинарныеДанные.Записать(ИмяВременного);
		Исключение
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Уменьшение размеров изображений'"), УровеньЖурналаРегистрации.Ошибка, ,
										Выборка.Фильм, СтрШаблон(НСтр("ru = 'Ошибка сохранения файла %1; по причине: %2'"), ИмяВременного, ОписаниеОшибки()));
			Возврат;
		КонецПопытки;
		
		СтрокаКоманды = СтрШаблон("%1 %2 %3", УтилитаСжатияИзображений, ПараметрыУтилитыСжатия, ИмяВременного);
		ЗапуститьПриложение(СтрокаКоманды, , Истина, КодВозврата);
		
		НоваяКартинка     = Новый Картинка(ИмяВременного);
		БинарныеДанные    = НоваяКартинка.ПолучитьДвоичныеДанные();
		РазмерИзображения = БинарныеДанные.Размер();
		
		Если Выборка.СтарыйРазмер > РазмерИзображения Тогда
			
			СпрОбъект = Выборка.Фильм.ПолучитьОбъект();
			СпрОбъект.ОбменДанными.Загрузка = Истина;
			СпрОбъект.Афиша = Новый ХранилищеЗначения(НоваяКартинка);
			СпрОбъект.РазмерИзображения = БинарныеДанные.Размер();
			СпрОбъект.ВысотаИзображения = НоваяКартинка.Высота();
			СпрОбъект.ШиринаИзображения = НоваяКартинка.Ширина();
		
			Попытка
				СпрОбъект.Записать();
			Исключение
				ЗаписьЖурналаРегистрации(НСтр("ru = 'Уменьшение размеров изображений'"), УровеньЖурналаРегистрации.Ошибка, ,
											Выборка.Фильм, СтрШаблон(НСтр("ru = 'Ошибка записи фильма %1; по причине: %2'"), Выборка.Фильм, ОписаниеОшибки()));
				Возврат;
			КонецПопытки;
			
		КонецЕсли;
		
		УдалитьФайлы(ИмяВременного);
		
	КонецЦикла;
		
КонецПроцедуры

